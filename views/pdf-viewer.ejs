<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pdfName %> | AttendEase</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
<style>
  *{ box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
  html, body{ margin:0; background:#3a3f47; font-family:Arial, sans-serif; }
  body{ user-select:none; -webkit-user-select:none; -webkit-touch-callout:none; }

  .top-bar{
    position:sticky; top:0; z-index:5;
    display:flex; align-items:center; gap:12px;
    padding:12px 14px;
    background:#0B5D3B; color:#fff;
  }
  .top-bar a{ color:#fff; font-size:20px; display:flex; }
  .top-bar .name{
    font-size:14px; font-weight:600;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }

  #pages{ padding:12px; display:flex; flex-direction:column; align-items:center; gap:12px; }
  #pages canvas{ width:100%; max-width:900px; height:auto; background:#fff; box-shadow:0 2px 10px rgba(0,0,0,.4); }

  #status{ color:#ddd; text-align:center; padding:30px 14px; font-size:14px; }

  @media print{ body{ display:none; } }
</style>
</head>
<body>

<div class="top-bar">
  <a href="/group-chat/<%= groupId %>"><i class="bi bi-arrow-left"></i></a>
  <span class="name"><%= pdfName %></span>
</div>

<div id="status">Loading PDF...</div>

<div id="pages"
     data-message-id="<%= messageId %>"
     data-viewer="<%= viewerName %>"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script>

pdfjsLib.GlobalWorkerOptions.workerSrc =
    "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js";

const pagesEl = document.getElementById("pages");
const statusEl = document.getElementById("status");
const messageId = pagesEl.dataset.messageId;
const viewerName = pagesEl.dataset.viewer;

document.addEventListener("contextmenu", (e) => e.preventDefault());

function drawWatermark(ctx, width, height) {
    ctx.save();
    ctx.globalAlpha = 0.10;
    ctx.fillStyle = "#000";
    ctx.font = Math.round(width / 22) + "px Arial";
    ctx.rotate(-Math.PI / 6);
    for (let y = -height; y < height * 2; y += height / 4) {
        for (let x = -width; x < width * 2; x += width / 2) {
            ctx.fillText(viewerName, x, y);
        }
    }
    ctx.restore();
}

async function loadPdf() {

    try {

        const response = await fetch("/group-pdf/" + messageId);

        if (!response.ok) {
            statusEl.textContent = "Unable to open this PDF.";
            return;
        }

        const data = await response.arrayBuffer();
        const pdf = await pdfjsLib.getDocument({ data }).promise;

        statusEl.style.display = "none";

        const ratio = window.devicePixelRatio || 1;

        for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {

            const page = await pdf.getPage(pageNum);

            const baseViewport = page.getViewport({ scale: 1 });
            const targetWidth = Math.min(window.innerWidth - 24, 900);
            const scale = (targetWidth / baseViewport.width) * ratio;
            const viewport = page.getViewport({ scale });

            const canvas = document.createElement("canvas");
            canvas.width = viewport.width;
            canvas.height = viewport.height;

            const ctx = canvas.getContext("2d");

            await page.render({ canvasContext: ctx, viewport }).promise;

            drawWatermark(ctx, canvas.width, canvas.height);

            pagesEl.appendChild(canvas);
        }

    } catch (error) {
        console.error("PDF load error:", error);
        statusEl.textContent = "Something went wrong while loading the PDF.";
    }
}

loadPdf();

</script>
</body>
</html>