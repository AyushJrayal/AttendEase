<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Today's Attendance • AttendEase</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>

  <style>      

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #eef2f7;
            font-family: Arial, sans-serif;
            color: #222;
        }

        .attendance-page {
            width: 100%;
            max-width: 850px;
            margin: auto;
            padding: 20px 15px 50px;
        }

        /* HEADER */

        .page-header {

            background: linear-gradient(
                135deg,
                #0B5D3B,
                #15803D
            );

            color: white;

            border-radius: 24px;

            padding: 25px;

            margin-bottom: 20px;

            box-shadow:
                0 10px 25px rgba(0,0,0,.12);

        }

        .logo {

            width: 65px;
            height: 65px;

            object-fit: contain;

            background: white;

            border-radius: 15px;

            padding: 5px;

        }

        .page-header h1 {

            font-size: 26px;
            font-weight: 700;

            margin: 0;

        }

        .page-header p {

            margin: 4px 0 0;

            opacity: .85;

        }

        /* INFORMATION */

        .info-card {

            background: white;

            border-radius: 20px;

            padding: 20px;

            margin-bottom: 20px;

            box-shadow:
                0 5px 20px rgba(0,0,0,.06);

        }

        .info-item {

            margin-bottom: 12px;

        }

        .info-label {

            color: #777;

            font-size: 13px;

        }

        .info-value {

            font-weight: 600;

            color: #222;

        }

        /* STATISTICS */

        .stats {

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 12px;

            margin-bottom: 20px;

        }

        .stat {

            background: white;

            border-radius: 18px;

            padding: 18px;

            text-align: center;

            box-shadow:
                0 5px 18px rgba(0,0,0,.06);

        }

        .stat-number {

            font-size: 28px;

            font-weight: 700;

        }

        .stat-label {

            color: #777;

            font-size: 13px;

        }

        .present-number {

            color: #15803D;

        }

        .absent-number {

            color: #dc2626;

        }

        /* TABLE */

        .table-card {

            background: white;

            border-radius: 20px;

            padding: 18px;

            box-shadow:
                0 5px 20px rgba(0,0,0,.06);

            overflow-x: auto;

        }

        .table {

            margin-bottom: 0;

            vertical-align: middle;

        }

        .table thead th {

            background: #0B5D3B;

            color: white;

            white-space: nowrap;

        }

        .student-name {

            font-weight: 600;

        }

        .time {

            font-size: 13px;

            color: #666;

        }

        /* BUTTON */

        .download-btn {

            background: #0B5D3B;

            color: white;

            border: none;

            border-radius: 14px;

            padding: 14px 20px;

            font-weight: 600;

            width: 100%;

            margin-top: 20px;

        }

        .download-btn:hover {

            background: #084a2f;

            color: white;

        }

        .back-btn {

            color: #0B5D3B;

            text-decoration: none;

            font-weight: 600;

            display: inline-block;

            margin-bottom: 15px;

        }

        /* MOBILE */

        @media (max-width: 600px) {

            .attendance-page {

                padding: 12px 10px 40px;

            }

            .page-header {

                padding: 20px;

                border-radius: 20px;

            }

            .page-header h1 {

                font-size: 21px;

            }

            .logo {

                width: 55px;
                height: 55px;

            }

            .stats {

                grid-template-columns:
                    repeat(3, 1fr);

                gap: 8px;

            }

            .stat {

                padding: 13px 5px;

            }

            .stat-number {

                font-size: 23px;

            }

            .stat-label {

                font-size: 11px;

            }

            .table-card {

                padding: 10px;

                border-radius: 16px;

            }

            .table {

                font-size: 13px;

            }

        }
        
        /* =========================================
   ATTENDEASE MOBILE EXPORT SHEET
   Used only for the downloaded PNG
========================================= */

.export-sheet {
    position: absolute;
    left: -10000px;
    top: 0;

    width: 430px;

    background: #ffffff;
    color: #1f2937;

    padding: 22px;

    font-family: Arial, sans-serif;
}

.export-header {
    background: linear-gradient(
        135deg,
        #0B5D3B,
        #15803D
    );

    color: white;

    border-radius: 22px;

    padding: 24px 18px;

    text-align: center;

    margin-bottom: 16px;
}

.export-logo {
    width: 78px;
    height: 78px;

    object-fit: contain;

    background: white;

    padding: 6px;

    border-radius: 18px;

    margin-bottom: 10px;
}

.export-brand {
    margin: 0;

    font-size: 30px;

    font-weight: 800;
}

.export-subtitle {
    margin-top: 3px;

    font-size: 13px;

    opacity: .9;
}

.export-title {
    margin-top: 18px;

    font-size: 21px;

    font-weight: 700;
}

.export-info {
    background: #f5f7f8;

    border-radius: 18px;

    padding: 15px;

    margin-bottom: 15px;
}

.export-info-row {
    display: flex;

    justify-content: space-between;

    gap: 15px;

    padding: 8px 0;

    border-bottom: 1px solid #e5e7eb;
}

.export-info-row:last-child {
    border-bottom: none;
}

.export-label {
    color: #6b7280;

    font-size: 12px;
}

.export-value {
    color: #1f2937;

    font-size: 13px;

    font-weight: 700;

    text-align: right;
}

.export-stats {
    display: flex;

    gap: 8px;

    margin-bottom: 18px;
}

.export-stat {
    flex: 1;

    background: #f5f7f8;

    border-radius: 15px;

    padding: 13px 5px;

    text-align: center;
}

.export-stat-number {
    font-size: 23px;

    font-weight: 800;
}

.export-stat-label {
    margin-top: 3px;

    font-size: 10px;

    color: #6b7280;
}

.export-present {
    color: #15803d;
}

.export-absent {
    color: #dc2626;
}

.export-students-title {
    font-size: 16px;

    font-weight: 700;

    color: #0B5D3B;

    margin-bottom: 8px;
}

.export-student {
    display: flex;

    align-items: center;

    gap: 9px;

    padding: 12px 6px;

    border-bottom: 1px solid #e5e7eb;
}

.export-number {
    width: 25px;

    color: #777;

    font-size: 11px;

    text-align: center;
}

.export-student-info {
    flex: 1;

    min-width: 0;
}

.export-student-name {
    font-size: 13px;

    font-weight: 700;
}

.export-roll {
    margin-top: 2px;

    color: #777;

    font-size: 10px;
}

.export-status {
    text-align: right;

    min-width: 70px;
}

.export-present-badge,
.export-absent-badge {
    display: inline-block;

    padding: 5px 8px;

    border-radius: 50px;

    font-size: 9px;

    font-weight: 700;
}

.export-present-badge {
    background: #dcfce7;

    color: #166534;
}

.export-absent-badge {
    background: #fee2e2;

    color: #991b1b;
}

.export-time {
    margin-top: 3px;

    color: #777;

    font-size: 9px;
}

.export-footer {
    margin-top: 22px;

    padding-top: 15px;

    border-top: 1px solid #e5e7eb;

    text-align: center;

    color: #777;

    font-size: 10px;

    line-height: 18px;
}

.export-footer .brand {
    color: #0B5D3B;

    font-size: 13px;

    font-weight: 800;
}

.export-footer strong {
    color: #0B5D3B;
}

/* =====================================================
   CLASSIC ATTENDANCE SHEET
===================================================== */

/* =========================================================
   ATTENDEASE DOWNLOADABLE ATTENDANCE SHEET
   Clean portrait / mobile-friendly design
========================================================= */

/* =========================================================
   ATTENDEASE DOWNLOADABLE ATTENDANCE SHEET
   Clean portrait / mobile-friendly design
========================================================= */

/* =========================================================
   ATTENDEASE DOWNLOAD SHEET
   Professional mobile portrait attendance sheet
========================================================= */

.download-sheet {
    width: 900px;
    height: 1600px;

    position: fixed;
    left: -20000px;
    top: 0;

    background: #ffffff;
    color: #202520;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    overflow: hidden;

    visibility: visible;
    z-index: -1;
}


/* =========================================================
   HEADER
========================================================= */

.sheet-header {
    padding: 55px 60px 28px;
}

.sheet-brand {
    display: flex;
    align-items: center;
    gap: 20px;
}

.sheet-dragon {
    width: 78px;
    height: 78px;

    object-fit: contain;

    flex: 0 0 78px;
}

.sheet-brand-text {
    min-width: 0;
}

.sheet-title {
    margin: 0;

    color: #0b5d3b;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size: 46px;
    line-height: 1.05;

    font-weight: 700;

    white-space: nowrap;
}

.sheet-subtitle {
    margin-top: 8px;

    color: #777;

    font-size: 16px;

    letter-spacing: 1.8px;

    text-transform: uppercase;

    white-space: nowrap;
}


/* REPORT TITLE */

.sheet-label {
    margin-top: 45px;

    color: #333;

    font-size: 20px;

    font-weight: 700;

    letter-spacing: 3px;

    text-transform: uppercase;
}


/* =========================================================
   SIMPLE GREEN LINE
========================================================= */

.sheet-line {
    height: 3px;

    margin: 0 60px;

    background: #0b5d3b;
}


/* =========================================================
   CLASS / SUBJECT / DATE / TIME
========================================================= */

.sheet-info {
    margin:
        30px
        60px
        0;

    padding:
        0
        0
        28px;

    display: grid;

    grid-template-columns:
        1.6fr
        1fr;

    column-gap: 60px;

    row-gap: 26px;

    border-bottom:
        1px solid
        #dddddd;
}

.sheet-info > div {
    min-width: 0;
}

.sheet-info strong {
    display: block;

    margin-bottom: 7px;

    color: #777;

    font-size: 13px;

    font-weight: 700;

    letter-spacing: 1.5px;

    text-transform: uppercase;
}

.sheet-info span {
    display: block;

    color: #222;

    font-size: 22px;

    font-weight: 600;

    line-height: 1.3;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;
}


/* =========================================================
   STUDENT LIST
========================================================= */

.sheet-students {
    position: relative;

    margin-top: 35px;
}


/* =========================================================
   VERY LIGHT DRAGON WATERMARK
========================================================= */

.sheet-students::before {
    content: "";

    position: absolute;

    width: 520px;
    height: 520px;

    left: 50%;
    top: 180px;

    transform: translateX(-50%);

    background-image:
        url("/images/dragon-logo.png");

    background-repeat: no-repeat;

    background-position: center;

    background-size: contain;

    opacity: 0.2;

    pointer-events: none;
}


/* =========================================================
   TABLE HEADER
========================================================= */

.sheet-table-head {
    position: relative;
    z-index: 2;

    display: grid;

    grid-template-columns:
        150px
        minmax(0, 1fr)
        150px;

    align-items: center;

    height: 58px;

    padding:
        0
        60px;

    background: #0b5d3b;

    color: #ffffff;

    font-size: 14px;

    font-weight: 700;

    letter-spacing: 1px;

    text-transform: uppercase;
}

.sheet-table-head > div {
    min-width: 0;
}

.sheet-table-head > div:last-child {
    text-align: right;
}


/* =========================================================
   STUDENT ROW
========================================================= */

.sheet-student {
    position: relative;
    z-index: 2;

    display: grid;

    grid-template-columns:
        150px
        minmax(0, 1fr)
        150px;

    align-items: center;

    min-height: 68px;

    padding:
        0
        60px;

    border-bottom:
        1px solid
        #e3e3e3;

    font-size: 19px;

    background: rgba(255,255,255,.96);
}

.sheet-student:nth-child(even) {
    background: rgba(250,250,250,.96);
}

.sheet-student > div {
    min-width: 0;
}

.sheet-roll {
    color: #555;

    font-weight: 600;
}

.sheet-name {
    padding-right: 20px;

    color: #222;

    font-weight: 600;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;
}

.sheet-student > div:last-child {
    text-align: right;
}


/* =========================================================
   STATUS
========================================================= */

.sheet-present,
.sheet-absent {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    width: 118px;
    height: 34px;

    border-radius: 5px;

    font-size: 12px;

    font-weight: 700;

    letter-spacing: .5px;
}

.sheet-present {
    color: #176b3a;

    background: #edf7f0;

    border:
        1px solid
        #cfe7d5;
}

.sheet-absent {
    color: #a33a3a;

    background: #fbefef;

    border:
        1px solid
        #eed0d0;
}


/* =========================================================
   FOOTER
========================================================= */

.sheet-footer {
    position: absolute;

    left: 60px;
    right: 60px;

    bottom: 45px;

    padding-top: 20px;

    border-top:
        1px solid
        #dddddd;

    text-align: center;

    color: #888;

    font-size: 14px;

    line-height: 25px;
}

.sheet-footer strong {
    color: #0b5d3b;

    font-weight: 600;
}



    </style>

</head>


<body>


<div class="attendance-page">


    <!-- BACK -->

    <a
        href="/attendance"
        class="back-btn">

        <i class="bi bi-arrow-left"></i>

        Attendance

    </a>


    <!-- HEADER -->

    <div class="page-header">

        <div
            class="d-flex align-items-center gap-3">

            <img
                src="/images/university-logo.jpg"
                class="logo"
                alt="University Logo">

            <div>

                <h1>
                    Today's Attendance
                </h1>

                <p>
                    AttendEase Attendance Report
                </p>

            </div>

        </div>

    </div>


    <!-- SESSION INFORMATION -->

    <div class="info-card">

        <div class="row">

            <div class="col-6 col-md-3 info-item">

                <div class="info-label">
                    Department
                </div>

                <div class="info-value">
                    <%= session.department %>
                </div>

            </div>


            <div class="col-6 col-md-3 info-item">

                <div class="info-label">
                    Semester
                </div>

                <div class="info-value">
                    Semester <%= session.semester %>
                </div>

            </div>


            <div class="col-6 col-md-3 info-item">

                <div class="info-label">
                    Section
                </div>

                <div class="info-value">
                    Section <%= session.section %>
                </div>

            </div>


            <div class="col-6 col-md-3 info-item">

                <div class="info-label">
                    Subject
                </div>

                <div class="info-value">
                    <%= session.subject %>
                </div>

            </div>

        </div>


        <hr>


        <div class="row">

            <div class="col-6">

                <div class="info-label">
                    Date
                </div>

                <div class="info-value">
                    <%= session.date %>
                </div>

            </div>


            <div class="col-6">

                <div class="info-label">
                    Started
                </div>

                <div class="info-value">

                    <%= new Date(
                        session.startTime
                    ).toLocaleTimeString() %>

                </div>

            </div>

        </div>

    </div>


    <!-- STATISTICS -->

    <%
        const presentCount =
            attendance.filter(
                record => record.present
            ).length;

        const absentCount =
            attendance.length - presentCount;
    %>


    <div class="stats">


        <div class="stat">

            <div class="stat-number">

                <%= attendance.length %>

            </div>

            <div class="stat-label">

                Total Students

            </div>

        </div>


        <div class="stat">

            <div
                class="stat-number present-number">

                <%= presentCount %>

            </div>

            <div class="stat-label">

                Present

            </div>

        </div>


        <div class="stat">

            <div
                class="stat-number absent-number">

                <%= absentCount %>

            </div>

            <div class="stat-label">

                Absent

            </div>

        </div>


    </div>


    <!-- ATTENDANCE TABLE -->

    <div class="table-card">

        <h5 class="mb-3">

            <i class="bi bi-people-fill"></i>

            Student Attendance

        </h5>


        <div class="table-responsive">

            <table class="table table-bordered">

                <thead>

                    <tr>

                        <th>#</th>

                        <th>Student</th>

                        <th>Roll No</th>

                        <th>Status</th>

                        <th>Time</th>

                    </tr>

                </thead>


                <tbody>


                <% attendance.forEach(
                    (record, index) => {

                %>


                    <tr>

                        <td>
                            <%= index + 1 %>
                        </td>


                        <td>

                            <% if (
                                record.studentId
                            ) { %>

                                <span
                                    class="student-name">

                                    <%= record.studentId.name %>

                                </span>

                            <% } else { %>

                                <span
                                    class="text-danger">

                                    Student Deleted

                                </span>

                            <% } %>

                        </td>


                        <td>

                            <% if (
                                record.studentId
                            ) { %>

                                <%= record.studentId.rollNo %>

                            <% } else { %>

                                —

                            <% } %>

                        </td>


                        <td>

                            <% if (
                                record.present
                            ) { %>

                                <span
                                    class="badge bg-success">

                                    <i
                                        class="bi bi-check-circle-fill">
                                    </i>

                                    Present

                                </span>

                            <% } else { %>

                                <span
                                    class="badge bg-danger">

                                    <i
                                        class="bi bi-x-circle-fill">
                                    </i>

                                    Absent

                                </span>

                            <% } %>

                        </td>


                        <td>

                            <% if (
                                record.present &&
                                record.markedAt
                            ) { %>

                                <span
                                    class="time">

                                    <%= new Date(
                                        record.markedAt
                                    ).toLocaleTimeString() %>

                                </span>

                            <% } else { %>

                                —

                            <% } %>

                        </td>

                    </tr>


                <% }) %>


                </tbody>

            </table>

        </div>


        <!-- DOWNLOAD -->

        <button
            class="download-btn"
            onclick="downloadAttendance()">

            <i class="bi bi-download"></i>

            Download Today's Attendance

        </button>

        <!-- =========================================
     DOWNLOADABLE ATTENDANCE SHEET
     This section is converted into PNG
========================================= -->

<div id="downloadSheet" class="download-sheet" >

    <!-- HEADER -->

    <div class="sheet-header">

        <div class="sheet-brand">

            <!-- CHANGE THIS PATH if your dragon logo
                 has a different filename -->

            <img
                src="/images/university-logo.jpg"
                class="sheet-dragon"
                alt="AttendEase Logo">

            <div>

                <div class="sheet-title">
                    AttendEase
                </div>

                <div class="sheet-subtitle">
                    Smart Attendance System
                </div>

            </div>

        </div>


        <div class="sheet-label">
            ATTENDANCE SHEET
        </div>

    </div>


    <!-- GREEN LINE -->

    <div class="sheet-line"></div>


    <!-- CLASS INFORMATION -->

    <div class="sheet-info">

        <div>

            <strong>Class</strong>

            <span>
                <%= session.department %>
                · Semester <%= session.semester %>
                · Section <%= session.section %>
            </span>

        </div>


        <div>

            <strong>Subject</strong>

            <span>
                <%= session.subject %>
            </span>

        </div>


        <div>

            <strong>Date</strong>

            <span>
                <%= session.date %>
            </span>

        </div>


        <div>

            <strong>Time</strong>

            <span>

                <%= new Date(
                    session.startTime
                ).toLocaleTimeString([], {
                    hour: "2-digit",
                    minute: "2-digit"
                }) %>

            </span>

        </div>

    </div>


    <!-- STUDENT LIST -->

    <div class="sheet-students">

        <div class="sheet-table-head">

            <span>ROLL NO</span>

            <span>NAME</span>

            <span>STATUS</span>

        </div>


        <% attendance.forEach(record => { %>

            <div class="sheet-student">

                <span class="sheet-roll">

                    <% if (record.studentId) { %>

                        <%= record.studentId.rollNo %>

                    <% } else { %>

                        —

                    <% } %>

                </span>


                <span class="sheet-name">

                    <% if (record.studentId) { %>

                        <%= record.studentId.name %>

                    <% } else { %>

                        Student Deleted

                    <% } %>

                </span>


                <span>

                    <% if (record.present) { %>

                        <span class="sheet-present">
                            PRESENT
                        </span>

                    <% } else { %>

                        <span class="sheet-absent">
                            ABSENT
                        </span>

                    <% } %>

                </span>

            </div>

        <% }) %>

    </div>


    <!-- FOOTER -->

    <div class="sheet-footer">

        <div>

            Generated by <strong>AttendEase</strong>

        </div>


        <div>

            Made by <strong>Ayush Jaryal</strong>

        </div>


        <div>

            🌐 <strong>Jaryal.shop</strong>

        </div>

    </div>

</div>

    </div>


</div>


<!-- Attendance image generator -->
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>

<script>

async function downloadAttendance() {

    const sheet = document.getElementById("downloadSheet");

    if (!sheet) {

        alert("Attendance sheet is not ready.");

        return;

    }

    try {

        const button = document.querySelector(".download-btn");

        if (button) {

            button.innerHTML =
                '<i class="bi bi-hourglass-split"></i> Creating sheet...';

            button.disabled = true;

        }


        const canvas = await html2canvas(sheet, {

            scale: 3,

            useCORS: true,

            backgroundColor: "#ffffff",

            logging: false

        });


        const link = document.createElement("a");

        link.download =
            "AttendEase-Attendance-<%= session.date %>.png";

        link.href =
            canvas.toDataURL("image/png");

        link.click();


        if (button) {

            button.innerHTML =
                '<i class="bi bi-check-circle-fill"></i> Downloaded';

            setTimeout(() => {

                button.innerHTML =
                    '<i class="bi bi-download"></i> Download Attendance';

                button.disabled = false;

            }, 2000);

        }

    } catch (error) {

        console.error(
            "Attendance image error:",
            error
        );

        alert(
            "Unable to create attendance image."
        );


        const button = document.querySelector(".download-btn");

        if (button) {

            button.innerHTML =
                '<i class="bi bi-download"></i> Download Attendance';

            button.disabled = false;

        }

    }

}

</script>


</body>

</html>

