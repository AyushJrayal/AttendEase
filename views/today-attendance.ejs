<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Today's Attendance • AttendEase</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>

  <style>      

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #eef2f7;
            font-family: Arial, sans-serif;
            color: #222;
        }

        .attendance-page {
            width: 100%;
            max-width: 850px;
            margin: auto;
            padding: 20px 15px 50px;
        }

        /* HEADER */

        .page-header {

            background: linear-gradient(
                135deg,
                #0B5D3B,
                #15803D
            );

            color: white;

            border-radius: 24px;

            padding: 25px;

            margin-bottom: 20px;

            box-shadow:
                0 10px 25px rgba(0,0,0,.12);

        }

        .logo {

            width: 65px;
            height: 65px;

            object-fit: contain;

            background: white;

            border-radius: 15px;

            padding: 5px;

        }

        .page-header h1 {

            font-size: 26px;
            font-weight: 700;

            margin: 0;

        }

        .page-header p {

            margin: 4px 0 0;

            opacity: .85;

        }

        /* INFORMATION */

        .info-card {

            background: white;

            border-radius: 20px;

            padding: 20px;

            margin-bottom: 20px;

            box-shadow:
                0 5px 20px rgba(0,0,0,.06);

        }

        .info-item {

            margin-bottom: 12px;

        }

        .info-label {

            color: #777;

            font-size: 13px;

        }

        .info-value {

            font-weight: 600;

            color: #222;

        }

        /* STATISTICS */

        .stats {

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 12px;

            margin-bottom: 20px;

        }

        .stat {

            background: white;

            border-radius: 18px;

            padding: 18px;

            text-align: center;

            box-shadow:
                0 5px 18px rgba(0,0,0,.06);

        }

        .stat-number {

            font-size: 28px;

            font-weight: 700;

        }

        .stat-label {

            color: #777;

            font-size: 13px;

        }

        .present-number {

            color: #15803D;

        }

        .absent-number {

            color: #dc2626;

        }

        /* TABLE */

        .table-card {

            background: white;

            border-radius: 20px;

            padding: 18px;

            box-shadow:
                0 5px 20px rgba(0,0,0,.06);

            overflow-x: auto;

        }

        .table {

            margin-bottom: 0;

            vertical-align: middle;

        }

        .table thead th {

            background: #0B5D3B;

            color: white;

            white-space: nowrap;

        }

        .student-name {

            font-weight: 600;

        }

        .time {

            font-size: 13px;

            color: #666;

        }

        /* BUTTON */

        .download-btn {

            background: #0B5D3B;

            color: white;

            border: none;

            border-radius: 14px;

            padding: 14px 20px;

            font-weight: 600;

            width: 100%;

            margin-top: 20px;

        }

        .download-btn:hover {

            background: #084a2f;

            color: white;

        }

        .back-btn {

            color: #0B5D3B;

            text-decoration: none;

            font-weight: 600;

            display: inline-block;

            margin-bottom: 15px;

        }

        /* MOBILE */

        @media (max-width: 600px) {

            .attendance-page {

                padding: 12px 10px 40px;

            }

            .page-header {

                padding: 20px;

                border-radius: 20px;

            }

            .page-header h1 {

                font-size: 21px;

            }

            .logo {

                width: 55px;
                height: 55px;

            }

            .stats {

                grid-template-columns:
                    repeat(3, 1fr);

                gap: 8px;

            }

            .stat {

                padding: 13px 5px;

            }

            .stat-number {

                font-size: 23px;

            }

            .stat-label {

                font-size: 11px;

            }

            .table-card {

                padding: 10px;

                border-radius: 16px;

            }

            .table {

                font-size: 13px;

            }

        }

/* =========================================================
   ATTENDEASE DOWNLOAD SHEET
   Professional mobile portrait attendance sheet
========================================================= */

.download-sheet {
    width: 900px;
    height: 1600px;

    background: #ffffff;
    color: #202520;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    overflow: hidden;
}


/* =========================================================
   HEADER
========================================================= */

.sheet-header {
    padding: 55px 60px 28px;
}

.sheet-brand {
    display: flex;
    align-items: center;
    gap: 20px;
}

.sheet-dragon {
    width: 78px;
    height: 78px;

    object-fit: contain;

    flex: 0 0 78px;
}

.sheet-brand-text {
    min-width: 0;
}

.sheet-title {
    margin: 0;

    color: #0b5d3b;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size: 46px;
    line-height: 1.05;

    font-weight: 700;

    white-space: nowrap;
}

.sheet-subtitle {
    margin-top: 8px;

    color: #777;

    font-size: 16px;

    letter-spacing: 1.8px;

    text-transform: uppercase;

    white-space: nowrap;
}


/* REPORT TITLE */

.sheet-label {
    margin-top: 45px;

    color: #333;

    font-size: 20px;

    font-weight: 700;

    letter-spacing: 3px;

    text-transform: uppercase;
}


/* =========================================================
   SIMPLE GREEN LINE
========================================================= */

.sheet-line {
    height: 3px;

    margin: 0 60px;

    background: #0b5d3b;
}


/* =========================================================
   CLASS / SUBJECT / DATE / TIME
========================================================= */

.sheet-info {
    margin:
        30px
        60px
        0;

    padding:
        0
        0
        28px;

    display: grid;

    grid-template-columns:
        1.6fr
        1fr;

    column-gap: 60px;

    row-gap: 26px;

    border-bottom:
        1px solid
        #dddddd;
}

.sheet-info > div {
    min-width: 0;
}

.sheet-info strong {
    display: block;

    margin-bottom: 7px;

    color: #777;

    font-size: 13px;

    font-weight: 700;

    letter-spacing: 1.5px;

    text-transform: uppercase;
}

.sheet-info span {
    display: block;

    color: #222;

    font-size: 22px;

    font-weight: 600;

    line-height: 1.3;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;
}


/* =========================================================
   STUDENT LIST
========================================================= */

.sheet-students {
    position: relative;

    margin-top: 35px;
}


/* =========================================================
   VERY LIGHT DRAGON WATERMARK
========================================================= */

.sheet-students::before {
    content: "";

    position: absolute;

    width: 520px;
    height: 520px;

    left: 50%;
    top: 180px;

    transform: translateX(-50%);

    background-image:
        url("/images/dragon-logo.png");

    background-repeat: no-repeat;

    background-position: center;

    background-size: contain;

    opacity: 0.2;

    pointer-events: none;
}


/* =========================================================
   TABLE HEADER
========================================================= */

.sheet-table-head {
    position: relative;
    z-index: 2;

    display: grid;

    grid-template-columns:
        150px
        minmax(0, 1fr)
        150px;

    align-items: center;

    height: 58px;

    padding:
        0
        60px;

    background: #0b5d3b;

    color: #ffffff;

    font-size: 14px;

    font-weight: 700;

    letter-spacing: 1px;

    text-transform: uppercase;
}

.sheet-table-head > div {
    min-width: 0;
}

.sheet-table-head > div:last-child {
    text-align: right;
}


/* =========================================================
   STUDENT ROW
========================================================= */

.sheet-student {
    position: relative;
    z-index: 2;

    display: grid;

    grid-template-columns:
        150px
        minmax(0, 1fr)
        150px;

    align-items: center;

    min-height: 68px;

    padding:
        0
        60px;

    border-bottom:
        1px solid
        #e3e3e3;

    font-size: 19px;

    background: rgba(255,255,255,.96);
}

.sheet-student:nth-child(even) {
    background: rgba(250,250,250,.96);
}

.sheet-student > div {
    min-width: 0;
}

.sheet-roll {
    color: #555;

    font-weight: 600;
}

.sheet-name {
    padding-right: 20px;

    color: #222;

    font-weight: 600;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;
}

.sheet-class-tag {
    display: block;
    margin-top: 3px;
    font-size: 12px;
    font-weight: 500;
    color: #888;
    white-space: normal;
}

.sheet-student > div:last-child {
    text-align: right;
}


/* =========================================================
   STATUS
========================================================= */

.sheet-present,
.sheet-absent {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    width: 118px;
    height: 34px;

    border-radius: 5px;

    font-size: 12px;

    font-weight: 700;

    letter-spacing: .5px;
}

.sheet-present {
    color: #176b3a;

    background: #edf7f0;

    border:
        1px solid
        #cfe7d5;
}

.sheet-absent {
    color: #a33a3a;

    background: #fbefef;

    border:
        1px solid
        #eed0d0;
}


/* =========================================================
   FOOTER
========================================================= */

.sheet-footer {
    position: absolute;

    left: 60px;
    right: 60px;

    bottom: 45px;

    padding-top: 20px;

    border-top:
        1px solid
        #dddddd;

    text-align: center;

    color: #888;

    font-size: 14px;

    line-height: 25px;
}

.sheet-footer strong {
    color: #0b5d3b;

    font-weight: 600;
}

.sheet-page-label {
    margin-top: 6px;
    font-size: 12px;
    color: #aaa;
}

/* Off-screen wrapper used only while html2canvas captures each page */
.sheet-render-slot {
    position: fixed;
    left: -20000px;
    top: 0;
    z-index: -1;
}

    </style>

</head>


<body>


<div class="attendance-page">


    <!-- BACK -->

     <a
        href="/attendance"
        class="back-btn">

        <i class="bi bi-arrow-left"></i>

        Attendance

    </a>


    <!-- HEADER -->

    <div class="page-header">

        <div
            class="d-flex align-items-center gap-3">

            <img
                src="/images/university-logo.jpg"
                class="logo"
                alt="University Logo">

            <div>

                <h1>
                    Today's Attendance
                </h1>

                <p>
                    AttendEase Attendance Report
                </p>

            </div>

        </div>

    </div>


    <!-- SESSION INFORMATION -->

    <div class="info-card">

<div class="row">

    <div class="col-6 col-md-3 info-item">
        <div class="info-label">Department</div>
        <div class="info-value">
            <%= session.isGlobal ? "All Departments" : session.department %>
        </div>
    </div>

    <div class="col-6 col-md-3 info-item">
        <div class="info-label">Semester</div>
        <div class="info-value">
            <%= session.isGlobal ? "All Semesters" : "Semester " + session.semester %>
        </div>
    </div>

    <div class="col-6 col-md-3 info-item">
        <div class="info-label">Section</div>
        <div class="info-value">
            <%= session.isGlobal ? "All Sections" : "Section " + session.section %>
        </div>
    </div>

    <div class="col-6 col-md-3 info-item">
        <div class="info-label">Subject</div>
        <div class="info-value"><%= session.subject %></div>
    </div>

</div>

        </div>


        <hr>


        <div class="row">

            <div class="col-6">

                <div class="info-label">
                    Date
                </div>

                <div class="info-value">
                    <%= session.date %>
                </div>

            </div>


            <div class="col-6">

                <div class="info-label">
                    Started
                </div>

                <div class="info-value">

                    <%= new Date(
                        session.startTime
                    ).toLocaleTimeString() %>

                </div>

            </div>

        </div>

    </div>


    <!-- STATISTICS -->

    <%
        const presentCount =
            attendance.filter(
                record => record.present
            ).length;

        const absentCount =
            attendance.length - presentCount;
    %>


    <div class="stats">


        <div class="stat">

            <div class="stat-number">

                <%= attendance.length %>

            </div>

            <div class="stat-label">

                Total Students

            </div>

        </div>


        <div class="stat">

            <div
                class="stat-number present-number">

                <%= presentCount %>

            </div>

            <div class="stat-label">

                Present

            </div>

        </div>


        <div class="stat">

            <div
                class="stat-number absent-number">

                <%= absentCount %>

            </div>

            <div class="stat-label">

                Absent

            </div>

        </div>


    </div>


    <!-- ATTENDANCE TABLE -->

    <div class="table-card">

        <h5 class="mb-3">

            <i class="bi bi-people-fill"></i>

            Student Attendance

        </h5>


        <div class="table-responsive">

            <table class="table table-bordered">

                <thead>

                    <tr>

                        <th>#</th>

                        <th>Student</th>

                        <th>Roll No</th>

                        <th>Status</th>

                        <th>Time</th>

                    </tr>

                </thead>


                <tbody>


                <% attendance.forEach(
                    (record, index) => {

                %>


                    <tr>

                        <td>
                            <%= index + 1 %>
                        </td>


                        <td>
    <% if (record.studentId) { %>
        <span class="student-name">
            <%= record.studentId.name %>
        </span>
        <% if (session.isGlobal) { %>
            <br>
            <small class="text-muted">
                <%= record.studentId.department %> · Sem <%= record.studentId.semester %>
            </small>
        <% } %>
    <% } else { %>
        <span class="text-danger">Student Deleted</span>
    <% } %>
</td>


                        <td>

                            <% if (
                                record.studentId
                            ) { %>

                                <%= record.studentId.rollNo %>

                            <% } else { %>

                                —

                            <% } %>

                        </td>


                        <td>

                            <% if (
                                record.present
                            ) { %>

                                <span
                                    class="badge bg-success">

                                    <i
                                        class="bi bi-check-circle-fill">
                                    </i>

                                    Present

                                </span>

                            <% } else { %>

                                <span
                                    class="badge bg-danger">

                                    <i
                                        class="bi bi-x-circle-fill">
                                    </i>

                                    Absent

                                </span>

                            <% } %>

                        </td>


                        <td>

                            <% if (
                                record.present &&
                                record.markedAt
                            ) { %>

                                <span
                                    class="time">

                                    <%= new Date(
                                        record.markedAt
                                    ).toLocaleTimeString() %>

                                </span>

                            <% } else { %>

                                —

                            <% } %>

                        </td>

                    </tr>


                <% }) %>


                </tbody>

            </table>

        </div>


        <!-- DOWNLOAD -->

        <button
            class="download-btn"
            onclick="downloadAttendance()">

            <i class="bi bi-download"></i>

            Download Today's Attendance

        </button>

        <!-- =========================================
     DOWNLOADABLE ATTENDANCE SHEET TEMPLATE
     JS clones this once per page and fills it in
     with a chunk of students before capturing it
========================================= -->

<div id="downloadSheetContainer"></div>

<template id="downloadSheetTemplate">
    <div class="download-sheet">

        <!-- HEADER -->

        <div class="sheet-header">

            <div class="sheet-brand">

                <img
                    src="/images/university-logo.jpg"
                    class="sheet-dragon"
                    alt="AttendEase Logo">

                <div>

                    <div class="sheet-title">
                        AttendEase
                    </div>

                    <div class="sheet-subtitle">
                        Smart Attendance System
                    </div>

                </div>

            </div>


            <div class="sheet-label">
                ATTENDANCE SHEET
            </div>

        </div>


        <!-- GREEN LINE -->

        <div class="sheet-line"></div>


        <!-- CLASS INFORMATION -->

        <div class="sheet-info">

            <div>
                <strong>Class</strong>
                <span class="sheet-class-value"></span>
            </div>

            <div>
                <strong>Subject</strong>
                <span class="sheet-subject-value"></span>
            </div>

            <div>
                <strong>Date</strong>
                <span class="sheet-date-value"></span>
            </div>

            <div>
                <strong>Time</strong>
                <span class="sheet-time-value"></span>
            </div>

        </div>


        <!-- STUDENT LIST -->

        <div class="sheet-students">

            <div class="sheet-table-head">
                <span>ROLL NO</span>
                <span>NAME</span>
                <span>STATUS</span>
            </div>

            <div class="sheet-student-rows"><!-- filled by JS per page --></div>

        </div>


        <!-- FOOTER -->

        <div class="sheet-footer">

            <div>Generated by <strong>AttendEase</strong></div>

            <div>Made by <strong>Ayush Jaryal</strong></div>

            <div>🌐 <strong>Jaryal.shop</strong></div>

            <div class="sheet-page-label"></div>

        </div>

    </div>
</template>


    </div>


</div>


<!-- EJS-rendered data lives here, completely separate from real JS,
     so VS Code's JavaScript checker never sees <% %> tags -->
<script type="application/json" id="attendanceDataJson">
<%- JSON.stringify(attendance.map(r => ({
    roll: r.studentId ? r.studentId.rollNo : "—",
    name: r.studentId ? r.studentId.name : "Student Deleted",
    department: r.studentId ? r.studentId.department : "",
    semester: r.studentId ? r.studentId.semester : "",
    section: r.studentId ? r.studentId.section : "",
    present: r.present
}))) %>
</script>

<script type="application/json" id="sessionMetaJson">
<%- JSON.stringify({
    isGlobal: session.isGlobal,
    date: session.date,
    subject: session.subject,
    department: session.department || "",
    semester: session.semester || "",
    section: session.section || "",
    startTime: session.startTime
}) %>
</script>

<!-- Attendance image generator -->
<script>

// Real, plain JavaScript — VS Code parses this correctly with zero errors,
// since it no longer contains any <% %> EJS syntax at all.
const attendanceData = JSON.parse(
    document.getElementById("attendanceDataJson").textContent
);

const sessionMeta = JSON.parse(
    document.getElementById("sessionMetaJson").textContent
);

const isGlobalSession = sessionMeta.isGlobal;

// How many student rows fit comfortably on one 900x1600 sheet.
// Tune this up/down after checking a real downloaded page.
const ROWS_PER_PAGE = 14;

function buildRowHTML(record) {
    const statusClass = record.present ? "sheet-present" : "sheet-absent";
    const statusText = record.present ? "PRESENT" : "ABSENT";

    let nameHTML = record.name;
    if (isGlobalSession && record.department) {
        nameHTML += `<span class="sheet-class-tag">${record.department} · Sem ${record.semester}${record.section ? " · Sec " + record.section : ""}</span>`;
    }

    return `
        <div class="sheet-student">
            <span class="sheet-roll">${record.roll}</span>
            <span class="sheet-name">${nameHTML}</span>
            <span><span class="${statusClass}">${statusText}</span></span>
        </div>
    `;
}

function getClassLabel() {
    if (isGlobalSession) {
        return "All Students";
    }
    return `${sessionMeta.department} · Semester ${sessionMeta.semester} · Section ${sessionMeta.section}`;
}

function getTimeLabel() {
    const d = new Date(sessionMeta.startTime);
    return d.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
}

async function downloadAttendance() {

    const button = document.querySelector(".download-btn");
    const template = document.getElementById("downloadSheetTemplate");
    const container = document.getElementById("downloadSheetContainer");

    if (!template || !container) {
        alert("Attendance sheet is not ready.");
        return;
    }

    // Present students first, then absent — same ordering shown on-page
    const sorted = [...attendanceData].sort((a, b) => {
        if (a.present !== b.present) return a.present ? -1 : 1;
        return String(a.roll).localeCompare(String(b.roll), undefined, { numeric: true });
    });

    const pages = [];
    for (let i = 0; i < sorted.length; i += ROWS_PER_PAGE) {
        pages.push(sorted.slice(i, i + ROWS_PER_PAGE));
    }
    if (pages.length === 0) pages.push([]);

    try {

        if (button) {
            button.disabled = true;
        }

        for (let pageIndex = 0; pageIndex < pages.length; pageIndex++) {

            if (button) {
                button.innerHTML =
                    `<i class="bi bi-hourglass-split"></i> Creating sheet ${pageIndex + 1} of ${pages.length}...`;
            }

            // Clone a fresh sheet from the template for this page
            const sheetEl = template.content.firstElementChild.cloneNode(true);

            sheetEl.querySelector(".sheet-class-value").textContent = getClassLabel();
            sheetEl.querySelector(".sheet-subject-value").textContent = sessionMeta.subject;
            sheetEl.querySelector(".sheet-date-value").textContent = sessionMeta.date;
            sheetEl.querySelector(".sheet-time-value").textContent = getTimeLabel();

            const rowsWrap = sheetEl.querySelector(".sheet-student-rows");
            rowsWrap.innerHTML = pages[pageIndex].map(buildRowHTML).join("");

            const pageLabel = sheetEl.querySelector(".sheet-page-label");
            if (pageLabel) {
                pageLabel.textContent = `Page ${pageIndex + 1} of ${pages.length}`;
            }

            // Wrap it off-screen so it renders but stays invisible to the user
            const slot = document.createElement("div");
            slot.className = "sheet-render-slot";
            slot.appendChild(sheetEl);
            container.appendChild(slot);

            // Give the browser a couple frames to actually paint it
            await new Promise(resolve =>
                requestAnimationFrame(() => requestAnimationFrame(resolve))
            );

            const canvas = await html2canvas(sheetEl, {
                scale: 3,
                useCORS: true,
                backgroundColor: "#ffffff",
                logging: false
            });

            const link = document.createElement("a");
            link.download =
                `AttendEase-Attendance-${sessionMeta.date}-page${pageIndex + 1}.png`;
            link.href = canvas.toDataURL("image/png");
            link.click();

            container.removeChild(slot);

            // brief pause so the browser doesn't choke on many downloads at once
            await new Promise(resolve => setTimeout(resolve, 400));
        }

        if (button) {
            button.innerHTML =
                '<i class="bi bi-check-circle-fill"></i> Downloaded';

            setTimeout(() => {
                button.innerHTML =
                    '<i class="bi bi-download"></i> Download Attendance';
                button.disabled = false;
            }, 2000);
        }

    } catch (error) {

        console.error("Attendance image error:", error);
        alert("Unable to create attendance image.");

        if (button) {
            button.innerHTML =
                '<i class="bi bi-download"></i> Download Attendance';
            button.disabled = false;
        }

    }

}

