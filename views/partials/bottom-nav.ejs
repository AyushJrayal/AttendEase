<style>

.bottom-nav a {
    position: relative;
    color: #777;
    text-decoration: none;
    transition: 0.2s ease;
}

/* Active button */
.bottom-nav a.active {
    color: #0B5D3B;
}

/* Active icon */
.bottom-nav a.active i {
    color: #0B5D3B;
}

/* Badge */
.nav-badge {
    position: absolute;
    top: -4px;
    right: 14px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 50px;
    background: #dc3545;
    color: white;
    font-size: 10px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
}

</style>


<div class="bottom-nav">

    <!-- HOME -->

    <a
        href="/student-dashboard"
        class="<%= currentPath === '/student-dashboard' ? 'active' : '' %>"
    >

        <i class="bi bi-house-fill"></i>

        <p>Home</p>

    </a>


    <!-- ATTENDANCE -->

    <a
        href="/student-attendance"
        class="<%= currentPath === '/student-attendance' ? 'active' : '' %>"
    >

        <i class="bi bi-book-fill"></i>

        <p>Attendance</p>

    </a>


    <!-- MESSAGES -->

    <a
        href="/inbox"
        class="<%= currentPath === '/inbox' ? 'active' : '' %>"
    >

        <i class="bi bi-send-fill"></i>

        <p>Message</p>

    </a>


    <!-- ALERTS -->

    <a
        href="/notifications"
        class="<%= currentPath === '/notifications' ? 'active' : '' %>"
    >

        <i class="bi bi-bell-fill"></i>

        <% if (unreadNotifCount > 0) { %>

            <span class="nav-badge">
                <%= unreadNotifCount %>
            </span>

        <% } %>

        <p>Alerts</p>

    </a>


    <!-- PROFILE -->

    <a
        href="/student-profile"
        class="<%= currentPath === '/student-profile' ? 'active' : '' %>"
    >

        <i class="bi bi-person-circle"></i>

        <p>Profile</p>

    </a>

</div>