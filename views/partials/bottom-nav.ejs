<style>

.bottom-nav a {
    position: relative;
}

.nav-badge {
    position: absolute;
    top: -4px;
    right: 14px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 50px;
    background: #dc3545;
    color: white;
    font-size: 10px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
}

</style>

<div class="bottom-nav">

    <a href="/student-dashboard" class="active">

        <i class="bi bi-house-fill"></i>

        <p>Home</p>

    </a>

    <a href="/student-attendance">

        <i class="bi bi-calendar-check"></i>

        <p>Attendance</p>

    </a>

    <a href="/inbox">

        <i class="bi bi-send"></i>

        <p>Message</p>

    </a>

    <a href="/notifications">

        <i class="bi bi-bell-fill"></i>

        <% if (unreadNotifCount > 0) { %>
            <span class="nav-badge"><%= unreadNotifCount %></span>
        <% } %>

        <p>Alerts</p>

    </a>

    <a href="/student-profile">

        <i class="bi bi-person"></i>

        <p>Profile</p>

    </a>

