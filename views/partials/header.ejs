<style>

/* =====================================================
   LATEST UPDATES
   ===================================================== */

.latest-updates {
    display: flex;

    width: calc(100% + 40px);

    height: 38px;

    margin-left: -20px;

    background: #FFFDF7;

    overflow: hidden;

    align-items: stretch;

    border-top: 1px solid #0B5D3B;
    border-bottom: 1px solid #0B5D3B;

    box-shadow: 0 1px 5px rgba(0, 0, 0, 0.06);
}


.updates-label {
    position: relative;

    z-index: 2;

    display: flex;

    align-items: center;

    background: #0B5D3B;

    color: #FFFFFF;

    padding: 0 16px 0 11px;

    font-size: 10px;

    font-weight: 700;

    letter-spacing: 0.8px;

    text-transform: uppercase;

    white-space: nowrap;

    flex-shrink: 0;

    clip-path: polygon(
        0 0,
        100% 0,
        88% 100%,
        0% 100%
    );
}


.updates-label::before {
    content: "✦";

    font-size: 10px;

    margin-right: 5px;
}


.updates-marquee {
    flex: 1;

    min-width: 0;

    overflow: hidden;

    display: flex;

    align-items: center;
}


.updates-marquee ul {
    display: flex;

    align-items: center;

    width: max-content;

    margin: 0;

    padding: 0;

    list-style: none;

    white-space: nowrap;

    animation: mobileUpdates 52s linear infinite;
}


.updates-marquee li {
    display: flex;

    align-items: center;

    color: #14213D;

    font-size: 11px;

    font-weight: 600;

    white-space: nowrap;
}


.updates-marquee li::after {
    content: "◆";

    color: #A8872D;

    font-size: 5px;

    margin: 0 16px;
}


@keyframes mobileUpdates {

    from {
        transform: translateX(0);
    }

    to {
        transform: translateX(-50%);
    }

}


</style>


<section class="latest-updates">

    <div class="updates-label">
        Latest
    </div>

    <div class="updates-marquee">

        <ul>

            <li>
                Check Out My Website Jaryal.shop on Google
            </li>

            <li>
                5% of our website total monthly sales is donated to Gurdwaras every month.
            </li>

            <li>
                Every purchase helps our NGO give back
            </li>

            <li>
                Shop with purpose — quality that gives back to the community
            </li>

            <li>
                Free shipping on orders over ₹10,000
            </li>

        </ul>

    </div>

</section>

<div class="student-header">

    <div class="student-header-content">

        <div class="welcome-small">
            STUDENT DASHBOARD
        </div>

        <h1>Welcome back,</h1>

        <h2>
            <%= student.name %>
        </h2>

        <p>
            BSc Computer Science · Semester <%= student.semester %> · Section <%= student.section %>
        </p>

    </div>

    <img
        class="university-logo"
        src="/images/university-logo.jpg"
        alt="University Logo"
    >

</div>
