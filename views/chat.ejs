<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>
        Chat • <%= otherStudent.name %>
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/chat.css">

    <script src="/socket.io/socket.io.js"></script>



</head>


<body>


<div class="chat-container">


    <!-- HEADER -->

    <div class="chat-header">

        <a
            href="/studentss"
            class="back">

            <i class="bi bi-arrow-left"></i>

        </a>


        <div class="avatar">

            <%= otherStudent.name.charAt(0).toUpperCase() %>

        </div>


        <div class="student-info">

            <h5>

                <%= otherStudent.name %>

            </h5>

<small id="onlineStatus" class="offline-status">
    <span class="status-dot"></span>
    Offline
</small>

        </div>

    </div>



    <!-- MESSAGES -->

    <div
        class="messages"
        id="messages">


        <% if (messages.length === 0) { %>

            <div
                style="
                text-align:center;
                color:#999;
                margin-top:40px;
                ">

                <i
                    class="bi bi-chat-dots"
                    style="font-size:35px;">
                </i>

                <p>
                    Start a conversation 👋
                </p>

            </div>

        <% } %>


        <% let lastDate = ""; %>

<% messages.forEach(msg => { %>

    <%
        const messageDate = new Date(msg.createdAt);
        const dateKey = messageDate.toLocaleDateString("en-IN", { timeZone: "Asia/Kolkata" });
        let dateLabel = "";
        const today = new Date();
        const todayKey = today.toLocaleDateString("en-IN", { timeZone: "Asia/Kolkata" });
        const yesterday = new Date();
        yesterday.setDate(yesterday.getDate() - 1);
        const yesterdayKey = yesterday.toLocaleDateString("en-IN", { timeZone: "Asia/Kolkata" });

        if (dateKey === todayKey) {
            dateLabel = "TODAY";
        } else if (dateKey === yesterdayKey) {
            dateLabel = "YESTERDAY";
        } else {
            dateLabel = messageDate.toLocaleDateString("en-IN", {
                timeZone: "Asia/Kolkata", day: "numeric", month: "long", year: "numeric"
            }).toUpperCase();
        }
    %>

    <% if (dateKey !== lastDate) { %>
        <div class="chat-date"><span><%= dateLabel %></span></div>
        <% lastDate = dateKey; %>
    <% } %>

    <%
        const isSent = msg.sender.toString() === currentStudent._id.toString();
    %>

    <div
        class="message <%= isSent ? 'sent' : 'received' %> <%= msg.deleted ? 'deleted' : '' %>"
        data-message-id="<%= msg._id %>"
        data-sender="<%= msg.sender %>"
        data-raw-text="<%= msg.deleted ? '' : msg.message %>"
    >

        <% if (msg.replyTo) { %>
            <div class="reply-quote">
                <span><%= msg.replyTo.message %></span>
            </div>
        <% } %>

        <span class="message-text">
            <% if (msg.deleted) { %>
                <i>This message was deleted</i>
            <% } else { %>
                <%= msg.message %>
            <% } %>
        </span>

        <% if (msg.edited && !msg.deleted) { %>
            <span class="edited-label">edited</span>
        <% } %>

        <span class="message-time">

            <%= new Date(msg.createdAt).toLocaleTimeString("en-IN", {
                timeZone: "Asia/Kolkata", hour: "2-digit", minute: "2-digit", hour12: true
            }) %>

            <% if (isSent && !msg.deleted) { %>
                <span class="message-seen" data-message-id="<%= msg._id %>">
                    <%= msg.status === "read" ? "Seen" : (msg.status === "delivered" ? "Delivered" : "Sent") %>
                </span>
            <% } %>

        </span>

    </div>

<% }) %>


       


    </div>

    

    <div id="typingIndicator" class="typing-indicator">
    <span></span>
    <span></span>
    <span></span>
</div>

<div id="replyPreview" class="reply-preview" style="display:none;">
    <div class="reply-preview-content">
        <span class="reply-preview-label">Replying to</span>
        <span id="replyPreviewText" class="reply-preview-text"></span>
    </div>
    <button type="button" id="cancelReply" class="cancel-reply">
        <i class="bi bi-x-lg"></i>
    </button>
</div>



    <!-- INPUT -->

    <form
        class="chat-input"
        id="chatForm">

        <input
            type="text"
            id="messageInput"
            placeholder="Type a message..."
            autocomplete="off"
            maxlength="1000">

        <button
            type="submit"
            class="send-btn">

            <i class="bi bi-send-fill"></i>

        </button>

    </form>
    <div id="msgContextMenu" class="msg-context-menu" style="display:none;">
    <div class="menu-item" data-action="reply"><i class="bi bi-reply-fill"></i> Reply</div>
    <div class="menu-item" data-action="edit"><i class="bi bi-pencil-fill"></i> Edit</div>
    <div class="menu-item danger" data-action="delete"><i class="bi bi-trash-fill"></i> Delete</div>
</div>


</div>




    <script>

const chatForm =
    document.getElementById("chatForm");

const messageInput =
    document.getElementById("messageInput");

const messagesContainer =
    document.getElementById("messages");

const receiverId =
    "<%= otherStudent._id %>";

const currentStudentId =
    "<%= currentStudent._id %>";

    


// ===============================
// SOCKET.IO
// ===============================

const socket = io();

const onlineStatus =
    document.getElementById("onlineStatus");

const typingIndicator =
    document.getElementById("typingIndicator");

// ===============================
// TYPING INDICATOR
// ===============================

let typingTimer;

messageInput.addEventListener("input", () => {

    if (messageInput.value.trim().length > 0) {

        // Tell receiver that we are typing
        socket.emit("typing", {
            senderId: currentStudentId,
            receiverId: receiverId
        });

        // Clear previous timer
        clearTimeout(typingTimer);

        // Stop typing after 1 second of inactivity
        typingTimer = setTimeout(() => {

            socket.emit("stopTyping", {
                senderId: currentStudentId,
                receiverId: receiverId
            });

        }, 1000);

    } else {

        // Input became empty
        clearTimeout(typingTimer);

        socket.emit("stopTyping", {
            senderId: currentStudentId,
            receiverId: receiverId
        });
    }
});

// Receiver is typing
socket.on("userTyping", (data) => {

    if (data.senderId === receiverId) {

        typingIndicator.style.display = "flex";

        scrollToBottom();
    }
});

// Receiver stopped typing
socket.on("userStoppedTyping", (data) => {

    if (data.senderId === receiverId) {

        typingIndicator.style.display = "none";

        scrollToBottom();
    }
});

// Mark all existing messages from this student as read
socket.emit("markMessagesRead", {
    studentId: currentStudentId,
    otherStudentId: receiverId
});





// Friend came online
socket.on("studentOnline", (data) => {

    console.log("Student online:", data);

    if (data.studentId === receiverId) {

        onlineStatus.innerHTML = `
            <span class="status-dot"></span>
            Online
        `;

        onlineStatus.classList.remove("offline-status");
        onlineStatus.classList.add("online-status");
    }

});

socket.on("studentOffline", (data) => {

    console.log("Student offline:", data);

    if (data.studentId === receiverId) {

        onlineStatus.innerHTML = `
            <span class="status-dot"></span>
            Offline
        `;

        onlineStatus.classList.remove("online-status");
        onlineStatus.classList.add("offline-status");
    }

});


// Friend sent me a message
socket.on("newMessage", (data) => {

    console.log(
        "New message received:",
        data
    );

    if (
        data.sender === receiverId &&
        data.receiver === currentStudentId
    ) {

        // Show message immediately
        addMessage(
            data,
            "received"
        );

        // Tell server that this message reached
// the receiver's browser
socket.emit("messageDelivered", {
    messageId: data._id
});

        // Mark this conversation as READ in MongoDB
        socket.emit("markMessagesRead", {
            studentId: currentStudentId,
            otherStudentId: receiverId
        });

        // 🔔 Notification sound
        const sound =
            document.getElementById("messageSound");

        if (sound) {
            sound.currentTime = 0;

            sound.play().catch(() => {
                console.log(
                    "Sound blocked until user interacts with page."
                );
            });
        }
    }
});



// Tell server which student is connected
socket.emit("studentJoin", {

    _id: currentStudentId

});

// ===============================
// MESSAGE DELIVERED
// ===============================

socket.on("messageDelivered", (data) => {

    const tick = document.querySelector(
        `.message-ticks[data-message-id="${data.messageId}"]`
    );

    if (!tick) {
        return;
    }

    tick.textContent = "✓✓";

});

// ===============================
// MESSAGES READ
// ===============================

socket.on("messagesRead", (data) => {

    if (!data || !data.messageIds) {
        return;
    }

    data.messageIds.forEach(messageId => {

        const tick = document.querySelector(
            `.message-ticks[data-message-id="${messageId}"]`
        );

        if (!tick) {
            return;
        }

        tick.textContent = "✓✓";

        tick.classList.add("read");

    });

});


// ===============================
// SCROLL
// ===============================

function scrollToBottom() {

    messagesContainer.scrollTop =
        messagesContainer.scrollHeight;

}

scrollToBottom();


// ===============================
// ADD MESSAGE TO CHAT
// ===============================

function addMessage(message, type) {

    const div = document.createElement("div");
    div.className = `message ${type}`;
    div.dataset.messageId = message._id;
    div.dataset.sender = message.sender;
    div.dataset.rawText = message.message;

    const time = new Date(message.createdAt)
        .toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });

    let replyHtml = "";
    if (message.replyTo) {
        replyHtml = `<div class="reply-quote"><span>${escapeHtml(message.replyTo.message)}</span></div>`;
    }

    let tickHtml = "";
    if (type === "sent") {
        tickHtml = `
            <span class="message-seen" data-message-id="${message._id}">
                Sent
            </span>
        `;
    }

    div.innerHTML = `
        ${replyHtml}
        <span class="message-text">${escapeHtml(message.message)}</span>
        <span class="message-time">
            ${time}
            ${tickHtml}
        </span>
    `;

    messagesContainer.appendChild(div);
    scrollToBottom();
}


socket.on("messageDelivered", (data) => {

    console.log("MESSAGE DELIVERED:", data);

    const tick = document.querySelector(
        `.message-ticks[data-message-id="${data.messageId}"]`
    );

    if (!tick) return;

    tick.innerHTML = "✓✓";
});


// ===============================
// SEND MESSAGE
// ===============================

chatForm.addEventListener("submit", async (e) => {

    e.preventDefault();

    const message = messageInput.value.trim();

    if (!message) return;

    // ===== EDIT MODE =====
    if (activeEditId) {

        try {

            const response = await fetch(`/messages/${activeEditId}`, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ message })
            });

            const data = await response.json();

            if (!data.success) {
                alert(data.message);
                return;
            }

            const el = document.querySelector(`.message[data-message-id="${activeEditId}"]`);
            if (el) {
                el.dataset.rawText = data.message.message;
                el.querySelector(".message-text").textContent = data.message.message;

                if (!el.querySelector(".edited-label")) {
                    const timeSpan = el.querySelector(".message-time");
                    const label = document.createElement("span");
                    label.className = "edited-label";
                    label.textContent = "edited";
                    timeSpan.parentNode.insertBefore(label, timeSpan);
                }
            }

            cancelEdit();

        } catch (error) {
            console.error("Edit message error:", error);
            alert("Unable to edit message.");
        }

        return;
    }

    // ===== NORMAL SEND (with optional reply) =====

    try {

        const response = await fetch("/messages", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                receiver: receiverId,
                message: message,
                replyTo: activeReplyId
            })
        });

        const data = await response.json();

        if (!data.success) {
            alert(data.message);
            return;
        }

        addMessage(data.message, "sent");

        messageInput.value = "";
        messageInput.focus();

        activeReplyId = null;
        replyPreview.style.display = "none";

    } catch (error) {
        console.error("Send message error:", error);
        alert("Unable to send message.");
    }

});


// ===============================
// RECEIVE MESSAGE IN REAL TIME
// ===============================
 


// ===============================
// HTML PROTECTION
// ===============================

function escapeHtml(text) {

    const div =
        document.createElement("div");

    div.textContent = text;

    return div.innerHTML;

}


// ===============================
// ENTER = SEND
// ===============================

messageInput.addEventListener(
    "keydown",
    (e) => {

        if (e.key === "Enter") {

            e.preventDefault();

            chatForm.requestSubmit();

        }

    }
);

// ===============================
// REPLY / EDIT / DELETE
// ===============================

let activeReplyId = null;
let activeEditId = null;

const contextMenu = document.getElementById("msgContextMenu");
const replyPreview = document.getElementById("replyPreview");
const replyPreviewText = document.getElementById("replyPreviewText");
const cancelReplyBtn = document.getElementById("cancelReply");

let longPressTimer;
let longPressTarget = null;

// --- Open context menu (long-press mobile / right-click desktop) ---

function openContextMenu(x, y, messageEl) {

    longPressTarget = messageEl;

    const isMine = messageEl.dataset.sender === currentStudentId;
    const isDeleted = messageEl.classList.contains("deleted");

    // Hide edit/delete for messages that aren't yours, or already deleted
    const editItem = contextMenu.querySelector('[data-action="edit"]');
    const deleteItem = contextMenu.querySelector('[data-action="delete"]');

    editItem.style.display = (isMine && !isDeleted) ? "flex" : "none";
    deleteItem.style.display = (isMine && !isDeleted) ? "flex" : "none";

    contextMenu.style.display = "block";

    const menuWidth = 160;
    const menuHeight = 130;

    let left = x;
    let top = y;

    if (left + menuWidth > window.innerWidth) {
        left = window.innerWidth - menuWidth - 10;
    }
    if (top + menuHeight > window.innerHeight) {
        top = window.innerHeight - menuHeight - 10;
    }

    contextMenu.style.left = `${left}px`;
    contextMenu.style.top = `${top}px`;
}

function closeContextMenu() {
    contextMenu.style.display = "none";
    longPressTarget = null;
}

document.addEventListener("click", (e) => {
    if (!contextMenu.contains(e.target)) {
        closeContextMenu();
    }
});

// Right-click (desktop)
messagesContainer.addEventListener("contextmenu", (e) => {

    const msgEl = e.target.closest(".message");
    if (!msgEl || msgEl.classList.contains("deleted") === undefined) return;
    if (!msgEl) return;

    e.preventDefault();
    openContextMenu(e.clientX, e.clientY, msgEl);
});

// Long-press (mobile)
messagesContainer.addEventListener("touchstart", (e) => {

    const msgEl = e.target.closest(".message");
    if (!msgEl) return;

    longPressTimer = setTimeout(() => {
        const touch = e.touches[0];
        openContextMenu(touch.clientX, touch.clientY, msgEl);

        if (navigator.vibrate) navigator.vibrate(30);

    }, 450);
});

messagesContainer.addEventListener("touchend", () => {
    clearTimeout(longPressTimer);
});

messagesContainer.addEventListener("touchmove", () => {
    clearTimeout(longPressTimer);
});

// --- Menu item actions ---

contextMenu.addEventListener("click", (e) => {

    const item = e.target.closest(".menu-item");
    if (!item || !longPressTarget) return;

    const action = item.dataset.action;
    const msgEl = longPressTarget;
    const messageId = msgEl.dataset.messageId;
    const rawText = msgEl.dataset.rawText;

    if (action === "reply") {
        startReply(messageId, rawText);
    } else if (action === "edit") {
        startEdit(messageId, rawText);
    } else if (action === "delete") {
        deleteMessage(messageId);
    }

    closeContextMenu();
});

// --- Reply flow ---

function startReply(messageId, text) {

    activeEditId = null;
    activeReplyId = messageId;

    replyPreviewText.textContent = text;
    replyPreview.style.display = "flex";

    messageInput.focus();
}

cancelReplyBtn.addEventListener("click", () => {
    activeReplyId = null;
    replyPreview.style.display = "none";
});

// --- Edit flow ---

function startEdit(messageId, text) {

    activeReplyId = null;
    replyPreview.style.display = "none";

    activeEditId = messageId;

    messageInput.value = text;
    messageInput.classList.add("editing-mode");
    messageInput.focus();
}

function cancelEdit() {
    activeEditId = null;
    messageInput.value = "";
    messageInput.classList.remove("editing-mode");
}

// --- Delete flow ---

async function deleteMessage(messageId) {

    if (!confirm("Delete this message?")) return;

    try {

        const response = await fetch(`/messages/${messageId}`, {
            method: "DELETE"
        });

        const data = await response.json();

        if (!data.success) {
            alert(data.message || "Unable to delete message.");
            return;
        }

        applyDeletedUI(messageId);

    } catch (error) {
        console.error("Delete message error:", error);
        alert("Unable to delete message.");
    }
}

function applyDeletedUI(messageId) {

    const el = document.querySelector(`.message[data-message-id="${messageId}"]`);
    if (!el) return;

    el.classList.add("deleted");
    el.dataset.rawText = "";

    const textSpan = el.querySelector(".message-text");
    if (textSpan) {
        textSpan.innerHTML = "<i>This message was deleted</i>";
    }

    const replyQuote = el.querySelector(".reply-quote");
    if (replyQuote) replyQuote.remove();
}

// --- Edit received via socket ---

socket.on("messageEdited", (data) => {

    const el = document.querySelector(`.message[data-message-id="${data._id}"]`);
    if (!el) return;

    el.dataset.rawText = data.message;

    const textSpan = el.querySelector(".message-text");
    if (textSpan) textSpan.textContent = data.message;

    if (!el.querySelector(".edited-label")) {
        const timeSpan = el.querySelector(".message-time");
        const label = document.createElement("span");
        label.className = "edited-label";
        label.textContent = "edited";
        timeSpan.parentNode.insertBefore(label, timeSpan);
    }
});

// --- Delete received via socket ---

socket.on("messageDeleted", (data) => {
    applyDeletedUI(data._id);
});

// --- Seen status update (extend your existing messagesRead listener) ---

socket.on("messagesRead", (data) => {

    if (!data || !data.messageIds) return;

    data.messageIds.forEach(messageId => {

        const seenSpan = document.querySelector(
            `.message-seen[data-message-id="${messageId}"]`
        );

        if (seenSpan) {
            seenSpan.textContent = "Seen";
        }
    });
});

</script>


<audio
    id="messageSound"
    preload="auto"
    src="/sounds/message.mp3">
</audio>


</body>

</html>