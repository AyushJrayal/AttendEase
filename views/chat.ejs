<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>
        Chat • <%= otherStudent.name %>
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet">

    <script src="/socket.io/socket.io.js"></script>

    <style>

        * {
            box-sizing: border-box;
        }

        html,
body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
}

.chat-container {
    position: fixed;
    inset: 0;
    height: 100vh;
    height: 100dvh;
 }


        /* HEADER */

      .chat-header {
    background: #0E6B3F;
    color: white;
    padding: 15px;

    display: flex;
    align-items: center;
    gap: 12px;

    flex: 0 0 auto;

    position: relative;
    z-index: 10;
}

        .back {

            color: white;

            font-size: 24px;

            text-decoration: none;

        }

        .avatar {

            width: 42px;

            height: 42px;

            border-radius: 50%;

            background: white;

            color: #0E6B3F;

            display: flex;

            align-items: center;

            justify-content: center;

            font-weight: 700;

            font-size: 18px;

        }

        .student-info {

            flex: 1;

        }

        .student-info h5 {

            margin: 0;

            font-size: 17px;

        }

        .student-info small {

            opacity: .8;

        }


        /* MESSAGES */

        .messages {

            flex: 1;

            overflow-y: auto;

            padding: 20px 15px;

            background: #f5f7fb;

        }

        .messages {
    flex: 1 1 auto;
    min-height: 0;

    overflow-y: auto;

    padding: 20px 15px;
    background: #f5f7fb;
}

        .sent {

            margin-left: auto;

            background: #0E6B3F;

            color: white;

            border-bottom-right-radius: 4px;

        }

        .received {

            margin-right: auto;

            background: white;

            color: #222;

            border-bottom-left-radius: 4px;

            box-shadow: 0 2px 6px rgba(0,0,0,.06);

        }

        .message-time {

            display: block;

            font-size: 10px;

            margin-top: 4px;

            opacity: .65;

            text-align: right;

        }


        /* INPUT */

        .chat-input {
    padding: 10px;
    background: white;
    border-top: 1px solid #eee;

    display: flex;
    gap: 8px;

    flex: 0 0 auto;

    position: relative;
    z-index: 10;
}

        .chat-input input {

            flex: 1;

            border: none;

            background: #f1f3f6;

            border-radius: 22px;

            padding: 12px 16px;

            outline: none;

            font-size: 15px;

        }

        .send-btn {

            width: 46px;

            height: 46px;

            border: none;

            border-radius: 50%;

            background: #0E6B3F;

            color: white;

            font-size: 19px;

        }

        .send-btn:active {

            transform: scale(.94);

        }


        @media (min-width: 501px) {

            .chat-container {
    width: 100%;
    max-width: 500px;
    height: 100vh;
    height: 100dvh;
    margin: auto;
    background: white;

    display: flex;
    flex-direction: column;

    position: fixed;
    top: 0;
    left: 50%;
    transform: translateX(-50%);

    overflow: hidden;
}

        }
        .status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #aaa;
    margin-right: 5px;
}

.online-status {
    color: #d8ffe8;
}

.online-status .status-dot {
    background: #45e878;
    box-shadow: 0 0 6px rgba(69, 232, 120, .8);
}

.offline-status {
    color: rgba(255,255,255,.7);
}

@media (max-width: 600px) {

    html,
    body {
        width: 100%;
        height: 100%;
        margin: 0;
        overflow: hidden;
    }

    .chat-container {
        width: 100%;
        max-width: none;

        position: fixed;
        inset: 0;

        height: 100vh;
        height: 100dvh;

        transform: none;
        left: 0;
    }
}

    </style>

</head>


<body>


<div class="chat-container">


    <!-- HEADER -->

    <div class="chat-header">

        <a
            href="/studentss"
            class="back">

            <i class="bi bi-arrow-left"></i>

        </a>


        <div class="avatar">

            <%= otherStudent.name.charAt(0).toUpperCase() %>

        </div>


        <div class="student-info">

            <h5>

                <%= otherStudent.name %>

            </h5>

<small id="onlineStatus" class="offline-status">
    <span class="status-dot"></span>
    Offline
</small>

<small id="typingStatus" style="display:none;">
    Typing...
</small>

        </div>

    </div>



    <!-- MESSAGES -->

    <div
        class="messages"
        id="messages">


        <% if (messages.length === 0) { %>

            <div
                style="
                text-align:center;
                color:#999;
                margin-top:40px;
                ">

                <i
                    class="bi bi-chat-dots"
                    style="font-size:35px;">
                </i>

                <p>
                    Start a conversation 👋
                </p>

            </div>

        <% } %>


        <% messages.forEach(msg => { %>


            <% const isSent =
                msg.sender.toString() ===
                currentStudent._id.toString();
            %>


            <div class="message <%= isSent ? 'sent' : 'received' %>">

                <%= msg.message %>

                <span class="message-time">

                    <%= new Date(msg.createdAt).toLocaleTimeString([], {
                        hour: '2-digit',
                        minute: '2-digit'
                    }) %>

                </span>

            </div>


        <% }) %>


    </div>



    <!-- INPUT -->

    <form
        class="chat-input"
        id="chatForm">

        <input
            type="text"
            id="messageInput"
            placeholder="Type a message..."
            autocomplete="off"
            maxlength="1000">

        <button
            type="submit"
            class="send-btn">

            <i class="bi bi-send-fill"></i>

        </button>

    </form>


</div>




    <script>

const chatForm =
    document.getElementById("chatForm");

const messageInput =
    document.getElementById("messageInput");

const messagesContainer =
    document.getElementById("messages");

const receiverId =
    "<%= otherStudent._id %>";

const currentStudentId =
    "<%= currentStudent._id %>";

    


// ===============================
// SOCKET.IO
// ===============================

const socket = io();

const onlineStatus =
    document.getElementById("onlineStatus");

const typingStatus =
    document.getElementById("typingStatus");

// ===============================
// TYPING INDICATOR
// ===============================

let typingTimer;

messageInput.addEventListener("input", () => {

    if (messageInput.value.trim().length > 0) {

        // Tell receiver that we are typing
        socket.emit("typing", {
            senderId: currentStudentId,
            receiverId: receiverId
        });

        // Clear previous timer
        clearTimeout(typingTimer);

        // Stop typing after 1 second of inactivity
        typingTimer = setTimeout(() => {

            socket.emit("stopTyping", {
                senderId: currentStudentId,
                receiverId: receiverId
            });

        }, 1000);

    } else {

        // Input became empty
        clearTimeout(typingTimer);

        socket.emit("stopTyping", {
            senderId: currentStudentId,
            receiverId: receiverId
        });
    }
});

// Receiver is typing
socket.on("userTyping", (data) => {

    if (data.senderId === receiverId) {

        typingStatus.style.display = "block";
        typingStatus.textContent = "Typing...";
    }
});


// Receiver stopped typing
socket.on("userStoppedTyping", (data) => {

    if (data.senderId === receiverId) {

        typingStatus.style.display = "none";
    }
});

// Mark all existing messages from this student as read
socket.emit("markMessagesRead", {
    studentId: currentStudentId,
    otherStudentId: receiverId
});





// Friend came online
socket.on("studentOnline", (data) => {

    console.log("Student online:", data);

    if (data.studentId === receiverId) {

        onlineStatus.innerHTML = `
            <span class="status-dot"></span>
            Online
        `;

        onlineStatus.classList.remove("offline-status");
        onlineStatus.classList.add("online-status");
    }

});

socket.on("studentOffline", (data) => {

    console.log("Student offline:", data);

    if (data.studentId === receiverId) {

        onlineStatus.innerHTML = `
            <span class="status-dot"></span>
            Offline
        `;

        onlineStatus.classList.remove("online-status");
        onlineStatus.classList.add("offline-status");
    }

});


// Friend sent me a message
socket.on("newMessage", (data) => {

    console.log(
        "New message received:",
        data
    );

    if (
        data.sender === receiverId &&
        data.receiver === currentStudentId
    ) {

        // Show message immediately
        addMessage(
            data,
            "received"
        );

        // Mark this conversation as READ in MongoDB
        socket.emit("markMessagesRead", {
            studentId: currentStudentId,
            otherStudentId: receiverId
        });

        // 🔔 Notification sound
        const sound =
            document.getElementById("messageSound");

        if (sound) {
            sound.currentTime = 0;

            sound.play().catch(() => {
                console.log(
                    "Sound blocked until user interacts with page."
                );
            });
        }
    }
});



// Tell server which student is connected
socket.emit("studentJoin", {

    _id: currentStudentId

});


// ===============================
// SCROLL
// ===============================

function scrollToBottom() {

    messagesContainer.scrollTop =
        messagesContainer.scrollHeight;

}

scrollToBottom();


// ===============================
// ADD MESSAGE TO CHAT
// ===============================

function addMessage(message, type) {

    const div =
        document.createElement("div");

    div.className =
        `message ${type}`;

    const time =
        new Date(message.createdAt)
            .toLocaleTimeString([], {

                hour: "2-digit",
                minute: "2-digit"

            });

    div.innerHTML = `

        ${escapeHtml(message.message)}

        <span class="message-time">

            ${time}

        </span>

    `;

    messagesContainer.appendChild(div);

    scrollToBottom();

}


// ===============================
// SEND MESSAGE
// ===============================

chatForm.addEventListener("submit", async (e) => {

    e.preventDefault();

    const message =
        messageInput.value.trim();

    if (!message) {
        return;
    }


    try {

        const response =
            await fetch("/messages", {

                method: "POST",

                headers: {

                    "Content-Type":
                        "application/json"

                },

                body: JSON.stringify({

                    receiver: receiverId,

                    message: message

                })

            });


        const data =
            await response.json();


        if (!data.success) {

            alert(data.message);

            return;

        }


        /*
         * IMPORTANT:
         *
         * We add the message here immediately
         * because the sender should see it instantly.
         */

        addMessage(
            data.message,
            "sent"
        );


        messageInput.value = "";

        messageInput.focus();


    } catch (error) {

        console.error(
            "Send message error:",
            error
        );

        alert(
            "Unable to send message."
        );

    }

});


// ===============================
// RECEIVE MESSAGE IN REAL TIME
// ===============================
 


// ===============================
// HTML PROTECTION
// ===============================

function escapeHtml(text) {

    const div =
        document.createElement("div");

    div.textContent = text;

    return div.innerHTML;

}


// ===============================
// ENTER = SEND
// ===============================

messageInput.addEventListener(
    "keydown",
    (e) => {

        if (e.key === "Enter") {

            e.preventDefault();

            chatForm.requestSubmit();

        }

    }
);

</script>
<script>
if (window.visualViewport) {

    function adjustChatHeight() {
        const chatContainer =
            document.querySelector(".chat-container");

        if (!chatContainer) return;

        chatContainer.style.height =
            window.visualViewport.height + "px";
    }

    window.visualViewport.addEventListener(
        "resize",
        adjustChatHeight
    );

    window.visualViewport.addEventListener(
        "scroll",
        adjustChatHeight
    );

    adjustChatHeight();
}
</script>

<audio
    id="messageSound"
    preload="auto"
    src="/sounds/message.mp3">
</audio>


</body>

</html>