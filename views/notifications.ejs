<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Notifications | AttendEase</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #fafafa;
            font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
        }

        .notif-page {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px 0 40px;
        }

        .page-header {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 16px;
            margin-bottom: 18px;
        }

        .page-header a {
            color: #262626;
            text-decoration: none;
            font-size: 20px;
        }

        .page-header h2 {
            margin: 0;
            font-size: 20px;
            font-weight: 700;
            color: #262626;
        }

        .notif-list {
            display: flex;
            flex-direction: column;
        }

        .notif-row {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            text-decoration: none;
            color: inherit;
        }

        .notif-row:hover {
            background: #f5f5f5;
        }

        .notif-row.unread {
            background: #eef6ff;
        }

        .notif-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            object-fit: cover;
            flex-shrink: 0;
        }

        .notif-icon-badge {
            position: relative;
        }

        .notif-icon-badge i {
            position: absolute;
            bottom: -3px;
            right: -3px;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: #0095F6;
            color: white;
            font-size: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid white;
        }

        .notif-icon-badge.follow i {
            background: #0095F6;
        }

        .notif-icon-badge.message i {
            background: #0E6B3F;
        }

        .notif-text {
            flex: 1;
            font-size: 14px;
            color: #262626;
            line-height: 1.4;
        }

        .notif-text b {
            font-weight: 700;
        }

        .notif-time {
            font-size: 12px;
            color: #9ca3af;
            display: block;
            margin-top: 2px;
        }

        .empty-message {
            text-align: center;
            padding: 60px 20px;
            color: #8e8e8e;
        }

                .notif-row-wrap {
            display: flex;
            align-items: center;
        }

        .notif-row-wrap .notif-row {
            flex: 1;
        }

        .notif-delete-btn {
            background: none;
            border: none;
            color: #9ca3af;
            font-size: 14px;
            padding: 10px 16px;
            cursor: pointer;
        }

        .notif-delete-btn:hover {
            color: #dc3545;
        }

        .empty-message i {
            font-size: 36px;
            display: block;
            margin-bottom: 10px;
        }

    </style>

</head>

<body>

<div class="notif-page">

    <div class="page-header">

        <a href="/student-dashboard">
            <i class="bi bi-arrow-left"></i>
        </a>

        <h2>Notifications</h2>

    </div>

    <div class="notif-list">

        <% if (notifications && notifications.length > 0) { %>

            <% notifications.forEach(notif => { %>

                <%
                    let href = "#";
                    let text = "";

                    if (notif.type === "follow") {
                        href = "/profile/" + notif.sender._id;
                        text = "started following you.";
                    } else if (notif.type === "message") {
                        href = "/chat/" + notif.sender._id;
                        text = notif.count > 1
                            ? "sent you " + notif.count + " messages."
                            : "sent you a message.";
                    }
                %>

                
                                                    <div class="notif-row-wrap" data-notif-id="<%= notif._id %>">

                    <a href="<%= href %>" class="notif-row <%= notif.read ? '' : 'unread' %>">

                        <div class="notif-icon-badge <%= notif.type %>">

                            <img
                                src="<%= notif.sender.photo %>"
                                alt="<%= notif.sender.name %>"
                                class="notif-avatar">

                            <i class="bi <%= notif.type === 'follow' ? 'bi-person-plus-fill' : 'bi-chat-fill' %>"></i>

                        </div>

                        <div class="notif-text">
                            <b><%= notif.sender.name %></b> <%= text %>
                            <span class="notif-time" data-timestamp="<%= notif.updatedAt.toISOString() %>"></span>
                        </div>

                    </a>

                    <button class="notif-delete-btn" data-notif-id="<%= notif._id %>">
                        <i class="bi bi-x-lg"></i>
                    </button>

                </div>

            <% }) %>

        <% } else { %>

            <div class="empty-message">
                <i class="bi bi-bell"></i>
                No notifications yet.
            </div>

        <% } %>

    </div>

</div>

<script>

function relativeTime(isoString) {

    const then = new Date(isoString);
    const now = new Date();

    const seconds = Math.floor((now - then) / 1000);

    if (seconds < 60) return "now";

    const minutes = Math.floor(seconds / 60);
    if (minutes < 60) return minutes + "m ago";

    const hours = Math.floor(minutes / 60);
    if (hours < 24) return hours + "h ago";

    const days = Math.floor(hours / 24);
    if (days < 7) return days + "d ago";

    const weeks = Math.floor(days / 7);
    if (weeks < 5) return weeks + "w ago";

    const months = Math.floor(days / 30);
    return months + "mo ago";

}

document.querySelectorAll(".notif-time[data-timestamp]").forEach(el => {
    el.textContent = relativeTime(el.dataset.timestamp);
});

document.querySelectorAll(".notif-delete-btn").forEach(btn => {

    btn.addEventListener("click", async (e) => {

        e.preventDefault();
        e.stopPropagation();

        const notifId = btn.dataset.notifId;

        try {

            const response = await fetch(`/notifications/${notifId}`, {
                method: "DELETE"
            });

            const data = await response.json();

            if (data.success) {
                const row = document.querySelector(`.notif-row-wrap[data-notif-id="${notifId}"]`);
                if (row) row.remove();
            } else {
                alert(data.message || "Unable to delete notification.");
            }

        } catch (error) {
            console.error("Delete notification error:", error);
            alert("Unable to delete notification.");
        }

    });

});

</script>

</body>

</html>