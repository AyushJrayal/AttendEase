<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Profile | AttendEase</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/student-dashboard.css">
</head>

<body>

<div class="profile-page">

    <!-- Header -->
    <div class="profile-header">

        <div class="profile-icon">
            <i class="bi bi-person-fill"></i>
        </div>

        <h1><%= student.name %></h1>

        <p>
            <%= student.department %>
            <span>•</span>
            Semester <%= student.semester %>
        </p>

    </div>


    <!-- Personal Information -->
    <div class="profile-card">

        <h2>
            <i class="bi bi-person-lines-fill"></i>
            Personal Information
        </h2>

        <div class="profile-row">
            <div class="row-icon">
                <i class="bi bi-person-badge"></i>
            </div>

            <div>
                <small>Roll Number</small>
                <strong><%= student.rollNo %></strong>
            </div>
        </div>


        <div class="profile-row">
            <div class="row-icon">
                <i class="bi bi-envelope"></i>
            </div>

            <div>
                <small>Email</small>
                <strong><%= student.email %></strong>
            </div>
        </div>


        <div class="profile-row">
            <div class="row-icon">
                <i class="bi bi-building"></i>
            </div>

            <div>
                <small>Department</small>
                <strong><%= student.department %></strong>
            </div>
        </div>


        <div class="profile-row">
            <div class="row-icon">
                <i class="bi bi-mortarboard"></i>
            </div>

            <div>
                <small>Semester</small>
                <strong>Semester <%= student.semester %></strong>
            </div>
        </div>

    </div>


    <!-- Account -->
    <div class="profile-card">

        <h2>
            <i class="bi bi-shield-check"></i>
            Account
        </h2>

        <div class="account-status">
            <i class="bi bi-check-circle-fill"></i>

            <div>
                <strong>Account Active</strong>
                <small>Your AttendEase account is active.</small>
            </div>
        </div>

    </div>


    <!-- Back Button -->
    <a href="/student-dashboard" class="back-button">
        <i class="bi bi-arrow-left"></i>
        Back to Dashboard
    </a>


    <div class="profile-footer">
        AttendEase • Smart Attendance System
        <br>
        Devloper-<b>Ayush Jaryal</b>
    </div>

</div>

</body>
</html>