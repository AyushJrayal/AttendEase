<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Profile | AttendEase</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/student-dashboard.css">
<link rel="stylesheet" href="/css/style.css">

    <style>

        .ig-profile-wrap {
            max-width: 420px;
            margin: 0 auto;
            padding: 24px 18px 40px;
            background: linear-gradient(180deg, #dfeaff 0%, #f5f8ff 45%, #ffffff 100%);
            min-height: 100vh;
        }

        .ig-top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 10px;
        }

        .ig-back {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #1f2937;
            text-decoration: none;
            box-shadow: 0 2px 8px rgba(0,0,0,.06);
        }

        .ig-card {
            background: white;
            border-radius: 24px;
            padding: 28px 20px 22px;
            box-shadow: 0 10px 30px rgba(0,0,0,.06);
            text-align: center;
        }

        .ig-card-title {
            text-align: left;
            font-size: 22px;
            font-weight: 700;
            color: #1f2937;
            margin: 0 0 18px;
        }

        .ig-avatar-wrap {
            position: relative;
            width: 96px;
            height: 96px;
            margin: 0 auto 14px;
        }

        .ig-avatar {
            width: 96px;
            height: 96px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #f9a8d4;
            display: block;
        }

        .ig-avatar-edit {
            position: absolute;
            bottom: -2px;
            right: -2px;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #0E6B3F;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid white;
            cursor: pointer;
            font-size: 13px;
        }

        .ig-name {
            font-size: 18px;
            font-weight: 700;
            color: #1f2937;
            margin: 0 0 4px;
        }

        .ig-subtitle {
            font-size: 13px;
            color: #9ca3af;
            margin: 0 0 2px;
        }

        .ig-stats {
            display: flex;
            justify-content: center;
            gap: 34px;
            margin-top: 20px;
        }

        .ig-stat {
            text-align: center;
        }

        .ig-stat-num {
            font-size: 16px;
            font-weight: 700;
            color: #1f2937;
            display: block;
        }

        .ig-stat-label {
            font-size: 12px;
            color: #9ca3af;
        }

        .profile-card {
            margin-top: 18px;
        }

        .back-button {
            margin-top: 20px;
        }
        .back-button2 {
            margin-top: 20px;
        }

    </style>
</head>

<body>

<div class="ig-profile-wrap">

    <div class="ig-top-bar">

        <a href="/student-dashboard" class="ig-back">
            <i class="bi bi-arrow-left"></i>
        </a>

    </div>

    <div class="ig-card">

        <h2 class="ig-card-title">My Profile</h2>

        <div class="ig-avatar-wrap">

            <img
    src="<%= student.photo || '/images/default-user.png' %>"
    class="ig-avatar"
    alt="profile picture"
    onerror="this.onerror=null; this.src='/images/default-user.jpg';">

            <label for="photoInput" class="ig-avatar-edit">
                <i class="bi bi-camera-fill"></i>
            </label>

        </div>

        <form
            id="photoForm"
            action="/profile-picture"
            method="POST"
            enctype="multipart/form-data">

            <input
                type="file"
                id="photoInput"
                name="photo"
                accept="image/*"
                style="display:none;"
                onchange="document.getElementById('photoForm').submit()">

        </form>

        <p class="ig-name"><%= student.name %></p>

        <p class="ig-subtitle">
            <%= student.department %>
        </p>

        <p class="ig-subtitle">
            Semester <%= student.semester %> &bull; Section <%= student.section %>
        </p>

        <div class="ig-stats">

            <div class="ig-stat">
                <span class="ig-stat-num"><%= followersCount %></span>
                <span class="ig-stat-label">Followers</span>
            </div>

            <div class="ig-stat">
                <span class="ig-stat-num"><%= followingCount %></span>
                <span class="ig-stat-label">Follows</span>
            </div>

        </div>

    </div>


    <!-- Personal Information -->
    <div class="profile-card">

        <h2>
            <i class="bi bi-person-lines-fill"></i>
            Personal Information
        </h2>

        <div class="profile-row">
            <div class="row-icon">
                <i class="bi bi-person-badge"></i>
            </div>

            <div>
                <small>Roll Number</small>
                <strong><%= student.rollNo %></strong>
            </div>
        </div>


        <div class="profile-row">
            <div class="row-icon">
                <i class="bi bi-envelope"></i>
            </div>

            <div>
                <small>Email</small>
                <strong><%= student.email %></strong>
            </div>
        </div>


        <div class="profile-row">
            <div class="row-icon">
                <i class="bi bi-building"></i>
            </div>

            <div>
                <small>Department</small>
                <strong><%= student.department %></strong>
            </div>
        </div>


        <div class="profile-row">
            <div class="row-icon">
                <i class="bi bi-mortarboard"></i>
            </div>

            <div>
                <small>Semester</small>
                <strong>Semester <%= student.semester %></strong>
            </div>
        </div>

    </div>


    <!-- Account -->
    <div class="profile-card">

        <h2>
            <i class="bi bi-shield-check"></i>
            Account
        </h2>

        <div class="account-status">
            <i class="bi bi-check-circle-fill"></i>

            <div>
                <strong>Account Active</strong>
                <small>Your AttendEase account is active.</small>
            </div>
        </div>

    </div>


    <a href="/logout" class="back-button2">
        <i class="bi bi-arrow-left"></i>
        Log Out
    </a>



    <%- include("partials/footer") %>
    <%- include("partials/bottom-nav") %>

</div>

</body>
</html>