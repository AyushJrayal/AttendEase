<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= group.name %>
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/chat.css">

    <script src="/socket.io/socket.io.js"></script>

    <style>

        .group-system-message {
            display: flex;
            justify-content: center;
            margin: 12px 15px;
        }

        .group-system-message span {
            background: #eef2f0;
            color: #6f7773;
            font-size: 12px;
            padding: 6px 12px;
            border-radius: 12px;
            text-align: center;
            max-width: 85%;
        }

        .group-info-btn {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            color: white;
            font-size: 20px;
            transition: 0.2s;
        }

        .group-info-btn:hover {
            background: #0E6B3F;
        }

        .group-sender-name {
            display: block;
            font-size: 12px;
            font-weight: 700;
            color: #0E6B3F;
            margin-bottom: 3px;
        }

        .pdf-card {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            min-width: 200px;
            max-width: 260px;
            background: rgba(0,0,0,0.06);
            border-radius: 10px;
            text-decoration: none;
            color: inherit;
        }

        .pdf-card > i {
            font-size: 30px;
            color: #d92d20;
            flex-shrink: 0;
        }

        .pdf-card-info {
            min-width: 0;
            display: flex;
            flex-direction: column;
        }

        .pdf-card-name {
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .pdf-card-hint {
            font-size: 11px;
            opacity: .7;
        }

        .pdf-preview-bar {
            display: none;
            align-items: center;
            gap: 10px;
            padding: 8px 14px;
            background: #fff;
            border-top: 1px solid #e5e7eb;
            font-size: 13px;
        }

        .pdf-preview-bar i.pdf-icon {
            color: #d92d20;
            font-size: 22px;
        }

        .pdf-preview-bar .pdf-preview-name {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .pdf-preview-bar button {
            border: none;
            background: transparent;
            color: #666;
            font-size: 16px;
        }
        .message.sending .pdf-card {
    opacity: .65;
    pointer-events: none;
}

.pdf-spinner {
    width: 18px;
    height: 18px;
    margin-left: auto;
    flex-shrink: 0;
    border: 2px solid rgba(0,0,0,0.15);
    border-top-color: #0E6B3F;
    border-radius: 50%;
    animation: pdfSpin .8s linear infinite;
}

@keyframes pdfSpin {
    to { transform: rotate(360deg); }
}

    </style>

</head>

<body>

<div class="chat-container">

    <!-- HEADER -->

    <div class="chat-header">

        <a href="/inbox" class="back">
            <i class="bi bi-arrow-left"></i>
        </a>

        <div class="avatar">
            <i class="bi bi-people-fill"></i>
        </div>

        <div class="student-info">

            <h5>
                <%= group.name %>
            </h5>

            <small class="offline-status">
                <%= group.members.length %> members
            </small>

        </div>

        <a href="/group-info/<%= group._id %>" class="group-info-btn">
            <i class="bi bi-info-circle"></i>
        </a>

    </div>

    <!-- MESSAGES -->

    <div class="messages" id="messages">

        <% if (messages.length === 0) { %>

            <div style="text-align:center; color:#999; margin-top:40px;">
                <i class="bi bi-chat-dots" style="font-size:35px;"></i>
                <p>Start the conversation 👋</p>
            </div>

        <% } %>

        <% let lastDate = ""; %>

        <% messages.forEach(msg => { %>

            <%
                const messageDate = new Date(msg.createdAt);
                const dateKey = messageDate.toLocaleDateString("en-IN", { timeZone: "Asia/Kolkata" });
                let dateLabel = "";
                const today = new Date();
                const todayKey = today.toLocaleDateString("en-IN", { timeZone: "Asia/Kolkata" });
                const yesterday = new Date();
                yesterday.setDate(yesterday.getDate() - 1);
                const yesterdayKey = yesterday.toLocaleDateString("en-IN", { timeZone: "Asia/Kolkata" });

                if (dateKey === todayKey) {
                    dateLabel = "TODAY";
                } else if (dateKey === yesterdayKey) {
                    dateLabel = "YESTERDAY";
                } else {
                    dateLabel = messageDate.toLocaleDateString("en-IN", {
                        timeZone: "Asia/Kolkata", day: "numeric", month: "long", year: "numeric"
                    }).toUpperCase();
                }
            %>

            <% if (dateKey !== lastDate) { %>
                <div class="chat-date"><span><%= dateLabel %></span></div>
                <% lastDate = dateKey; %>
            <% } %>

            <% if (msg.messageType === "system") { %>

                <div class="group-system-message" data-message-id="<%= msg._id %>">
                    <span><%= msg.text %></span>
                </div>

            <% } else { %>

                <% const isSent = msg.sender.toString() === currentStudent._id.toString(); %>

                <div
                    class="message <%= isSent ? 'sent' : 'received' %> <%= msg.imageUrl ? 'has-media' : '' %>"
                    data-message-id="<%= msg._id %>"
                    data-sender="<%= msg.sender %>"
                >

                    <% if (!isSent) { %>
                        <span class="group-sender-name"><%= msg.senderName %></span>
                    <% } %>

                    <% if (msg.imageUrl) { %>

                        <img
                            src="<%= msg.imageUrl %>"
                            class="chat-image"
                            alt="image message">

                    <% } else if (msg.pdfUrl) { %>

                        <a href="/pdf-viewer/<%= msg._id %>" class="pdf-card">
                            <i class="bi bi-file-earmark-pdf-fill"></i>
                            <div class="pdf-card-info">
                                <span class="pdf-card-name"><%= msg.pdfName %></span>
                                <span class="pdf-card-hint">Tap to view</span>
                            </div>
                        </a>

                    <% } else { %>

                        <span class="message-text"><%= msg.text %></span>

                    <% } %>

                    <span class="message-time">
                        <%= new Date(msg.createdAt).toLocaleTimeString("en-IN", {
                            timeZone: "Asia/Kolkata", hour: "2-digit", minute: "2-digit", hour12: true
                        }) %>
                    </span>

                </div>

            <% } %>

        <% }) %>

    </div>

    <div id="typingIndicator" class="typing-indicator">
        <span></span>
        <span></span>
        <span></span>
    </div>

    <div id="imagePreviewBar" class="image-preview-bar" style="display:none;">
        <div class="image-preview-wrap">
            <img id="imagePreviewThumb" src="" alt="preview">
            <button type="button" id="cancelImage" class="cancel-image">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

    <div id="pdfPreviewBar" class="pdf-preview-bar">
        <i class="bi bi-file-earmark-pdf-fill pdf-icon"></i>
        <span class="pdf-preview-name" id="pdfPreviewName"></span>
        <button type="button" id="cancelPdf"><i class="bi bi-x-lg"></i></button>
    </div>

    <!-- INPUT -->

    <form class="chat-input" id="chatForm" enctype="multipart/form-data">

        <label for="imageInput" class="attach-btn">
            <i class="bi bi-image-fill"></i>
        </label>

        <input
            type="file"
            id="imageInput"
            accept="image/*"
            style="display:none;">

        <label for="pdfInput" class="attach-btn">
            <i class="bi bi-file-earmark-pdf-fill"></i>
        </label>

        <input
            type="file"
            id="pdfInput"
            accept="application/pdf"
            style="display:none;">

        <input
            type="text"
            id="messageInput"
            placeholder="Message the group..."
            autocomplete="off"
            maxlength="1000">

        <button type="submit" class="send-btn">
            <i class="bi bi-send-fill"></i>
        </button>

    </form>

    <div id="imageViewer" class="image-viewer" style="display:none;">
        <button id="closeViewer" class="close-viewer">
            <i class="bi bi-x-lg"></i>
        </button>
        <img id="viewerImg" src="" alt="full image">
    </div>

</div>

<script>

const chatForm = document.getElementById("chatForm");
const messageInput = document.getElementById("messageInput");
const messagesContainer = document.getElementById("messages");

const groupId = "<%= group._id %>";
const currentStudentId = "<%= currentStudent._id %>";
const currentStudentName = "<%= currentStudent.name %>";

const socket = io();

const typingIndicator = document.getElementById("typingIndicator");

socket.emit("studentJoin", { _id: currentStudentId });
socket.emit("joinGroup", { groupId: groupId });

// ===============================
// TYPING INDICATOR
// ===============================

let typingTimer;
let typingNames = new Set();

messageInput.addEventListener("input", () => {

    if (messageInput.value.trim().length > 0) {

        socket.emit("groupTyping", {
            groupId: groupId,
            senderId: currentStudentId,
            senderName: currentStudentName
        });

        clearTimeout(typingTimer);

        typingTimer = setTimeout(() => {
            socket.emit("groupStopTyping", {
                groupId: groupId,
                senderId: currentStudentId
            });
        }, 1000);

    } else {

        clearTimeout(typingTimer);

        socket.emit("groupStopTyping", {
            groupId: groupId,
            senderId: currentStudentId
        });
    }
});

socket.on("userTypingGroup", (data) => {

    if (data.senderId === currentStudentId) return;

    typingNames.add(data.senderName);
    typingIndicator.style.display = "flex";
    scrollToBottom();
});

socket.on("userStoppedTypingGroup", (data) => {

    typingIndicator.style.display = "none";
    scrollToBottom();
});

// ===============================
// SYSTEM MESSAGE
// ===============================

function addSystemMessage(message) {

    const div = document.createElement("div");

    div.className = "group-system-message";

    div.dataset.messageId = message._id;

    div.innerHTML = `
        <span>${escapeHtml(message.text)}</span>
    `;

    messagesContainer.appendChild(div);

    scrollToBottom();

}

// ===============================
// RECEIVE GROUP MESSAGE
// ===============================

socket.on("newGroupMessage", (data) => {

    if (data.groupId !== groupId) return;

    if (data.messageType === "system") {

        addSystemMessage(data);

        return;

    }

    if (data.sender === currentStudentId) return;

    addMessage(data, "received");

    const sound = document.getElementById("messageSound");

    if (sound) {

        sound.currentTime = 0;

        sound.play().catch(() => {});

    }

});

// ===============================
// SCROLL
// ===============================

function scrollToBottom() {
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
}

scrollToBottom();

// ===============================
// ADD MESSAGE
// ===============================

function addMessage(message, type) {

    const div = document.createElement("div");
    div.className = `message ${type}`;
    if (message.imageUrl) div.classList.add("has-media");

    div.dataset.messageId = message._id;
    div.dataset.sender = message.sender;

    const time = new Date(message.createdAt)
        .toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });

    let nameHtml = "";
    if (type === "received") {
        nameHtml = `<span class="group-sender-name">${escapeHtml(message.senderName)}</span>`;
    }

    let bodyHtml = "";
    if (message.imageUrl) {
        bodyHtml = `<img src="${message.imageUrl}" class="chat-image" alt="image message">`;
    } else if (message.hasPdf) {
        bodyHtml = `
            <a href="/pdf-viewer/${message._id}" class="pdf-card">
                <i class="bi bi-file-earmark-pdf-fill"></i>
                <div class="pdf-card-info">
                    <span class="pdf-card-name">${escapeHtml(message.pdfName)}</span>
                    <span class="pdf-card-hint">Tap to view</span>
                </div>
            </a>
        `;
    } else {
        bodyHtml = `<span class="message-text">${escapeHtml(message.text)}</span>`;
    }

    div.innerHTML = `
        ${nameHtml}
        ${bodyHtml}
        <span class="message-time">${time}</span>
    `;

    messagesContainer.appendChild(div);
    scrollToBottom();
}

function escapeHtml(text) {
    const div = document.createElement("div");
    div.textContent = text || "";
    return div.innerHTML;
}
function addPendingPdf(fileName) {

    const div = document.createElement("div");
    div.className = "message sent sending";

    div.innerHTML = `
        <div class="pdf-card">
            <i class="bi bi-file-earmark-pdf-fill"></i>
            <div class="pdf-card-info">
                <span class="pdf-card-name">${escapeHtml(fileName)}</span>
                <span class="pdf-card-hint">Sending...</span>
            </div>
            <div class="pdf-spinner"></div>
        </div>
        <span class="message-time">Sending</span>
    `;

    messagesContainer.appendChild(div);
    scrollToBottom();

    return div;
}

// ===============================
// IMAGE PICKER + PREVIEW
// ===============================

const imageInput = document.getElementById("imageInput");
const imagePreviewBar = document.getElementById("imagePreviewBar");
const imagePreviewThumb = document.getElementById("imagePreviewThumb");
const cancelImageBtn = document.getElementById("cancelImage");

let selectedImageFile = null;

imageInput.addEventListener("change", () => {

    const file = imageInput.files[0];
    if (!file) return;

    // one attachment at a time
    clearPdfSelection();

    selectedImageFile = file;

    const reader = new FileReader();
    reader.onload = (e) => {
        imagePreviewThumb.src = e.target.result;
        imagePreviewBar.style.display = "block";
    };
    reader.readAsDataURL(file);
});

cancelImageBtn.addEventListener("click", () => {
    selectedImageFile = null;
    imageInput.value = "";
    imagePreviewBar.style.display = "none";
});

// ===============================
// PDF PICKER + PREVIEW
// ===============================

const pdfInput = document.getElementById("pdfInput");
const pdfPreviewBar = document.getElementById("pdfPreviewBar");
const pdfPreviewName = document.getElementById("pdfPreviewName");
const cancelPdfBtn = document.getElementById("cancelPdf");

let selectedPdfFile = null;

function clearPdfSelection() {
    selectedPdfFile = null;
    pdfInput.value = "";
    pdfPreviewBar.style.display = "none";
}

pdfInput.addEventListener("change", () => {

    const file = pdfInput.files[0];
    if (!file) return;

    if (file.type !== "application/pdf") {
        alert("Please choose a PDF file.");
        clearPdfSelection();
        return;
    }

    if (file.size > 10 * 1024 * 1024) {
        alert("PDF must be smaller than 10 MB.");
        clearPdfSelection();
        return;
    }

    // one attachment at a time
    selectedImageFile = null;
    imageInput.value = "";
    imagePreviewBar.style.display = "none";

    selectedPdfFile = file;
    pdfPreviewName.textContent = file.name;
    pdfPreviewBar.style.display = "flex";
});

cancelPdfBtn.addEventListener("click", clearPdfSelection);

// ===============================
// SEND MESSAGE
// ===============================

chatForm.addEventListener("submit", async (e) => {

    e.preventDefault();

    const message = messageInput.value.trim();

    if (!message && !selectedImageFile && !selectedPdfFile) return;

    messageInput.value = "";
    const fileToSend = imageInput.files[0];
    const pdfToSend = selectedPdfFile;
    imageInput.value = "";
    selectedImageFile = null;
    imagePreviewBar.style.display = "none";
    clearPdfSelection();
    messageInput.focus();

    socket.emit("groupStopTyping", {
        groupId: groupId,
        senderId: currentStudentId
    });

    try {

        // PDFs go through their own route
        if (pdfToSend) {

            const pendingEl = addPendingPdf(pdfToSend.name);

            try {

                const pdfData = new FormData();
                pdfData.append("groupId", groupId);
                pdfData.append("pdf", pdfToSend);

                const pdfResponse = await fetch("/group-messages/pdf", {
                    method: "POST",
                    body: pdfData
                });

                const pdfResult = await pdfResponse.json();

                pendingEl.remove();

                if (!pdfResult.success) {
                    alert(pdfResult.message);
                } else {
                    addMessage(pdfResult.message, "sent");
                }

            } catch (pdfError) {

                console.error("Send PDF error:", pdfError);
                pendingEl.remove();
                alert("Unable to send PDF.");

            }

            if (!message && !fileToSend) return;
        }

        const formData = new FormData();
        formData.append("groupId", groupId);
        formData.append("message", message);

        if (fileToSend) {
            formData.append("image", fileToSend);
        }

        const response = await fetch("/group-messages", {
            method: "POST",
            body: formData
        });

        const data = await response.json();

        if (!data.success) {
            alert(data.message);
            return;
        }

        addMessage(data.message, "sent");

    } catch (error) {
        console.error("Send group message error:", error);
        alert("Unable to send message.");
    }

});

// ===============================
// ENTER = SEND
// ===============================

messageInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
        e.preventDefault();
        chatForm.requestSubmit();
    }
});

// ===============================
// IMAGE VIEWER
// ===============================

const imageViewer = document.getElementById("imageViewer");
const viewerImg = document.getElementById("viewerImg");
const closeViewerBtn = document.getElementById("closeViewer");

messagesContainer.addEventListener("click", (e) => {
    const img = e.target.closest(".chat-image");
    if (!img) return;

    viewerImg.src = img.src;
    imageViewer.style.display = "flex";
});

closeViewerBtn.addEventListener("click", () => {
    imageViewer.style.display = "none";
    viewerImg.src = "";
});

imageViewer.addEventListener("click", (e) => {
    if (e.target === imageViewer) {
        imageViewer.style.display = "none";
        viewerImg.src = "";
    }
});

</script>

<audio id="messageSound" preload="auto" src="/sounds/message.mp3"></audio>

</body>

</html>