<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Youth Festival Registration | AttendEase</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        /* =========================================
           COLOR THEME
        ========================================= */

        :root {
            --green: #0B5D3B;
            --dark-green: #08452D;
            --light-green: #EAF4EF;
            --cream: #FFFDF7;
            --gold: #A8872D;
            --dark-text: #14213D;
            --border: #D9E5DE;
        }


        /* =========================================
           BODY
        ========================================= */

        body {
            background: #F4F8F5 !important;
            color: var(--dark-text);
            font-family: Arial, Helvetica, sans-serif;
        }


        /* =========================================
           LATEST UPDATES
        ========================================= */

        .latest-updates {
            display: flex;
            width: 100%;
            height: 40px;

            background: var(--cream);

            overflow: hidden;
            align-items: stretch;

            box-shadow: 0 1px 5px rgba(0, 0, 0, 0.08);

            border-top: 1px solid var(--green);
            border-bottom: 1px solid var(--green);
        }


        .updates-label {
            position: relative;
            z-index: 2;

            display: flex;
            align-items: center;

            background: var(--green);
            color: #FFFFFF;

            padding: 0 18px 0 12px;

            font-size: 10px;
            font-weight: 700;

            letter-spacing: 0.8px;
            text-transform: uppercase;

            white-space: nowrap;
            flex-shrink: 0;

            clip-path: polygon(
                0 0,
                100% 0,
                88% 100%,
                0% 100%
            );
        }


        .updates-label::before {
            content: "✦";

            font-size: 11px;

            margin-right: 5px;

            color: #F1D77A;
        }


        .updates-marquee {
            flex: 1;

            min-width: 0;

            overflow: hidden;

            display: flex;
            align-items: center;
        }


        .updates-marquee ul {
            display: flex;
            align-items: center;

            width: max-content;

            margin: 0;
            padding: 0;

            list-style: none;

            white-space: nowrap;

            animation: mobileUpdates 52s linear infinite;
        }


        .updates-marquee li {
            display: flex;
            align-items: center;

            color: var(--dark-text);

            font-size: 11.5px;
            font-weight: 600;

            white-space: nowrap;
        }


        .updates-marquee li::after {
            content: "◆";

            color: var(--gold);

            font-size: 6px;

            margin: 0 18px;
        }


        @keyframes mobileUpdates {

            from {
                transform: translateX(0);
            }

            to {
                transform: translateX(-50%);
            }

        }


        /* =========================================
           ATTENDEASE HEADER
        ========================================= */

        .header {
            width: 100%;

            padding: 24px 20px 22px;

            display: flex;
            flex-direction: column;

            align-items: center;
            justify-content: center;

            text-align: center;

            background: var(--cream);

            border-bottom: 1px solid var(--border);
        }


        .header img {
            width: 85px;
            height: 85px;

            object-fit: contain;

            display: block;

            margin: 0 auto 10px;

            border-radius: 50%;

            background: #FFFFFF;

            padding: 3px;

            box-shadow:
                0 3px 12px rgba(11, 93, 59, 0.15);
        }


        .header h1 {
            margin: 0;

            color: var(--green);

            font-size: 29px;

            font-weight: 800;

            line-height: 1.1;

            letter-spacing: 0.3px;
        }


        .header p {
            margin: 6px 0 0;

            color: #68756F;

            font-size: 12px;

            font-weight: 500;

            letter-spacing: 0.7px;
        }


        /* =========================================
           MAIN CONTAINER
        ========================================= */

        .festival-container {
            padding-top: 35px;
            padding-bottom: 50px;
        }


        /* =========================================
           REGISTRATION CARD
        ========================================= */

        .festival-card {

            max-width: 900px;

            margin: auto;

            border: 1px solid var(--border) !important;

            border-radius: 14px !important;

            overflow: hidden;

            background: #FFFFFF;

            box-shadow:
                0 8px 30px rgba(11, 93, 59, 0.10) !important;
        }


        /* =========================================
           CARD HEADER
        ========================================= */

        .festival-card-header {

            background: var(--green);

            color: #FFFFFF;

            text-align: center;

            padding: 22px 20px;

            border: none;
        }


        .festival-card-header h2 {

            margin: 0;

            font-size: 24px;

            font-weight: 700;

            letter-spacing: 0.2px;
        }


        .festival-card-header p {

            margin-top: 6px;

            margin-bottom: 0;

            font-size: 12px;

            color: #E7F1EC;
        }


        /* =========================================
           FORM
        ========================================= */

        .festival-card-body {

            padding: 30px;
        }


        .form-label {

            color: var(--dark-green);

            font-size: 13px;

            font-weight: 700;

            margin-bottom: 7px;
        }


        .form-control,
        .form-select {

            min-height: 44px;

            border: 1px solid #CCDCD3;

            border-radius: 8px;

            font-size: 13px;

            color: var(--dark-text);

            background-color: #FFFFFF;

            transition: all 0.2s ease;
        }


        .form-control:focus,
        .form-select:focus {

            border-color: var(--green);

            box-shadow:
                0 0 0 0.20rem rgba(11, 93, 59, 0.12);

        }


        .form-control::placeholder {

            color: #9AA7A0;
        }


        /* =========================================
           SELECT GROUPS
        ========================================= */

        .form-select optgroup {

            color: var(--green);

            font-weight: 700;
        }


        /* =========================================
           REGISTER BUTTON
        ========================================= */

        .register-btn {

            min-height: 48px;

            border: none;

            border-radius: 8px;

            background: var(--green);

            color: #FFFFFF;

            font-size: 14px;

            font-weight: 700;

            letter-spacing: 0.3px;

            transition: all 0.2s ease;

            box-shadow:
                0 4px 10px rgba(11, 93, 59, 0.18);
        }


        .register-btn:hover {

            background: var(--dark-green);

            color: #FFFFFF;

            transform: translateY(-1px);

            box-shadow:
                0 6px 15px rgba(11, 93, 59, 0.25);
        }


        .register-btn i {

            margin-left: 5px;

            color: #F1D77A;
        }


        /* =========================================
           MOBILE
        ========================================= */

        @media (max-width: 576px) {

            .latest-updates {
                height: 36px;
            }


            .updates-label {

                padding: 0 13px 0 9px;

                font-size: 9px;

                letter-spacing: 0.6px;
            }


            .updates-label::before {

                font-size: 10px;

                margin-right: 4px;
            }


            .updates-marquee li {

                font-size: 10.5px;
            }


            .updates-marquee li::after {

                margin: 0 14px;

                font-size: 5px;
            }


            /* Header */

            .header {

                padding: 18px 15px 20px;

                align-items: center;

                text-align: center;
            }


            .header img {

                width: 70px;
                height: 70px;

                margin-bottom: 8px;
            }


            .header h1 {

                font-size: 24px;
            }


            .header p {

                font-size: 11px;

                margin-top: 5px;
            }


            /* Container */

            .festival-container {

                padding: 20px 12px 35px;
            }


            /* Card */

            .festival-card {

                border-radius: 10px !important;
            }


            .festival-card-header {

                padding: 18px 15px;
            }


            .festival-card-header h2 {

                font-size: 20px;
            }


            .festival-card-header p {

                font-size: 11px;
            }


            .festival-card-body {

                padding: 20px 16px;
            }


            .form-control,
            .form-select {

                min-height: 43px;
            }

        }


        /* =========================================
           VERY SMALL PHONES
        ========================================= */

        @media (max-width: 360px) {

            .header {

                padding: 15px 10px 18px;
            }


            .header img {

                width: 62px;
                height: 62px;
            }


            .header h1 {

                font-size: 22px;
            }


            .header p {

                font-size: 10px;
            }


            .festival-card-body {

                padding: 18px 13px;
            }

        }

    </style>

</head>


<body>


    <!-- =========================================
         LATEST UPDATES
    ========================================= -->

    <section class="latest-updates">

        <div class="updates-label">
            Latest
        </div>

        <div class="updates-marquee">

            <ul>

                <li>
                    Youth Festival Registration is now open
                </li>

                <li>
                    Register for your preferred event
                </li>

                <li>
                    Students are requested to enter correct details
                </li>

                <li>
                    AttendEase — Smart Attendance System
                </li>

                <li>
                    Youth Festival 2026
                </li>

            </ul>

        </div>

    </section>


    <!-- =========================================
         ATTENDEASE HEADER
    ========================================= -->

    <div class="header">

        <img
            src="/images/university-logo.jpg"
            alt="University Logo">

        <h1>
            AttendEase
        </h1>

        <p>
            Smart Attendance System
        </p>

    </div>


    <!-- =========================================
         REGISTRATION
    ========================================= -->

    <main class="festival-container">

        <div class="card festival-card">


            <!-- CARD HEADER -->

            <div class="festival-card-header">

                <h2>
                    Youth Festival Registration
                </h2>

                <p>
                    Enter your details carefully
                </p>

            </div>


            <!-- CARD BODY -->

            <div class="festival-card-body">

                <form action="/fest" method="POST">

                    <div class="row">


                        <!-- FULL NAME -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Full Name
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                name="name"
                                placeholder="Enter your full name"
                                required>

                        </div>


                        <!-- FATHER NAME -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Father's Name
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                name="fatherName"
                                placeholder="Enter father's name"
                                required>

                        </div>


                        <!-- ROLL NUMBER -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Roll Number
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                name="rollNo"
                                placeholder="Enter roll number"
                                required>

                        </div>
                        <!-- MOBILE -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Mobile Number
                            </label>

                            <input
                                type="tel"
                                class="form-control"
                                name="mobile"
                                placeholder="Enter mobile number"
                                maxlength="10"
                                required>

                        </div>


                        <!-- DEPARTMENT -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Department
                            </label>

                            <select
                                class="form-select"
                                name="department"
                                required>

                                <option value="">
                                    Select Department
                                </option>

                                <option value="BSc Computer Science">
                                    B.Sc Computer Science
                                </option>

                                <option value="BSc">
                                    B.Sc
                                </option>

                                <option value="BA">
                                    B.A.
                                </option>

                                <option value="BCom">
                                    B.Com
                                </option>

                                <option value="BCA">
                                    BCA
                                </option>

                                <option value="BSc IT">
                                    B.Sc IT
                                </option>

                                <option value="BSc Medical">
                                    B.Sc Medical
                                </option>

                                <option value="BSc Economics">
                                    B.Sc Economics
                                </option>

                                <option value="B.Voc (Software Development)">
                                    B.Voc (Software Development)
                                </option>

                                <option value="BBA">
                                    BBA
                                </option>

                            </select>

                        </div>


                       


                        <!-- SEMESTER -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Semester
                            </label>

                            <select
                                class="form-select"
                                name="semester"
                                required>

                                <option value="">
                                    Select Semester
                                </option>

                                <option value="1">
                                    Semester 1
                                </option>

                                <option value="2">
                                    Semester 2
                                </option>

                                <option value="3">
                                    Semester 3
                                </option>

                                <option value="4">
                                    Semester 4
                                </option>

                                <option value="5">
                                    Semester 5
                                </option>

                                <option value="6">
                                    Semester 6
                                </option>

                            </select>

                        </div>


                        <!-- SECTION -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Section
                            </label>

                            <select
                                class="form-select"
                                name="section"
                                required>

                                <option value="">
                                    Select Section
                                </option>

                                <option value="A">
                                    Section A
                                </option>

                                <option value="B">
                                    Section B
                                </option>

                                <option value="C">
                                    Section C
                                </option>

                            </select>

                        </div>

                         <!-- YOUTH FESTIVAL EVENT -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">
                                Youth Festival Event
                            </label>

                            <select
                                class="form-select"
                                name="event"
                                required>

                                <option value="">
                                    Select Event
                                </option>


                                <!-- FINE ART -->

                                <optgroup label="Fine Art">

                                    <option value="Painting on the spot">
                                        Painting on the spot
                                    </option>

                                    <option value="Poster Making">
                                        Poster Making
                                    </option>

                                    <option value="Cartooning">
                                        Cartooning
                                    </option>

                                    <option value="Collage">
                                        Collage
                                    </option>

                                    <option value="Clay Modelling">
                                        Clay Modelling
                                    </option>

                                    <option value="Rangoli">
                                        Rangoli
                                    </option>

                                    <option value="Phulkari">
                                        Phulkari
                                    </option>

                                </optgroup>


                                <!-- LITERARY -->

                                <optgroup label="Literary">

                                    <option value="Elocution (English)">
                                        Elocution (English)
                                    </option>

                                    <option value="Elocution (Hindi & Punjabi)">
                                        Elocution (Hindi & Punjabi)
                                    </option>

                                    <option value="Poetical Symposium">
                                        Poetical Symposium
                                    </option>

                                    <option value="Debate (English)">
                                        Debate (English)
                                    </option>

                                    <option value="Debate (Hindi & Punjabi)">
                                        Debate (Hindi & Punjabi)
                                    </option>

                                    <option value="Quiz">
                                        Quiz
                                    </option>

                                </optgroup>


                                <!-- DANCE -->

                                <optgroup label="Dance">

                                    <option value="Gidha">
                                        Gidha
                                    </option>

                                    <option value="Bhangra">
                                        Bhangra
                                    </option>

                                    <option value="Group Dance">
                                        Group Dance
                                    </option>

                                    <option value="Classical Dance">
                                        Classical Dance
                                    </option>

                                    <option value="Choreography">
                                        Choreography
                                    </option>

                                </optgroup>


                                <!-- THEATRE -->

                                <optgroup label="Theatre">

                                    <option value="Skit">
                                        Skit
                                    </option>

                                    <option value="Mime">
                                        Mime
                                    </option>

                                    <option value="Mimicry">
                                        Mimicry
                                    </option>

                                    <option value="Fancy Dress">
                                        Fancy Dress
                                    </option>

                                </optgroup>


                                <!-- MUSIC -->

                                <optgroup label="Music">

                                    <option value="Classical Instrumental">
                                        Classical Instrumental
                                    </option>

                                    <option value="Folk Song">
                                        Folk Song
                                    </option>

                                    <option value="Vaar Singing">
                                        Vaar Singing
                                    </option>

                                    <option value="Kawishri">
                                        Kawishri
                                    </option>

                                    <option value="Group Dance Upto 6 (Indian)">
                                        Group Dance Upto 6 (Indian)
                                    </option>

                                    <option value="Group Shabad/Bhajan Upto 6">
                                        Group Shabad/Bhajan Upto 6
                                    </option>

                                    <option value="Geet/Gazal">
                                        Geet/Gazal
                                    </option>

                                    <option value="Western Vocal Solo">
                                        Western Vocal Solo
                                    </option>

                                    <option value="Western inst. Solo">
                                        Western inst. Solo
                                    </option>

                                </optgroup>

                            </select>

                        </div>


                        


                        <!-- BUTTON -->

                        <div class="col-12 mt-3">

                            <button
                                type="submit"
                                class="btn register-btn w-100">

                                Register for Fest

                                <i class="bi bi-star-fill"></i>

                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>

    </main>


</body>

</html>