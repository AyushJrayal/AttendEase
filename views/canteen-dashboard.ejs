<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Canteen Dashboard | AttendEase</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f7f5;
        }

        .navbar {
            background: #0B5D3B;
            color: white;
            padding: 18px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .navbar h2 {
            margin: 0;
        }

        .logout {
            color: white;
            text-decoration: none;
            background: #08492f;
            padding: 9px 15px;
            border-radius: 8px;
        }

        .container {
            padding: 30px;
        }

        .welcome {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-top: 25px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
        }

        .card h3 {
            color: #0B5D3B;
            margin-top: 0;
        }

        .live-orders {
    background: white;
    margin-top: 30px;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
}

.orders-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.orders-header h2 {
    margin: 0;
    color: #0B5D3B;
}

#connectionStatus {
    font-size: 14px;
    font-weight: bold;
}

#connectionStatus.online {
    color: #198754;
}

#connectionStatus.offline {
    color: #dc3545;
}

.no-orders {
    text-align: center;
    padding: 40px 20px;
    color: #777;
}

.no-orders div {
    font-size: 45px;
}

.no-orders p {
    font-size: 18px;
    font-weight: bold;
    margin: 10px 0 5px;
}
    </style>
</head>

<body>

    <div class="navbar">
        <h2>🍴 AttendEase Canteen</h2>

        <a href="/canteen-logout" class="logout">
            Logout
        </a>
    </div>

    <div class="container">

        <div class="welcome">
            <h1>Welcome, <%= canteenOwner.name %> 👋</h1>
            <p>This is your Canteen Owner Dashboard.</p>
        </div>

        

    <div class="card">
        <h3>🍔 Menu Items</h3>
        <p>Manage your food items.</p>

        <a href="/manage-menu"
           style="color:#0B5D3B; font-weight:bold;">
            Manage Menu →
        </a>
    </div>

    <div class="card">
        <h3>📦 Orders</h3>
        <p>View and manage customer orders.</p>
    </div>

    <div class="card">
        <h3>📊 Today's Orders</h3>
        <p id="todayOrdersCount">0</p>
    </div>

    <div class="card">
        <h3>💰 Today's Sales</h3>
        <p id="todaySales">₹0</p>
    </div>

</div>


<!-- ========================= -->
<!-- LIVE ORDERS -->
<!-- ========================= -->

<div class="live-orders">

    <div class="orders-header">
        <h2>🔔 Live Orders</h2>

        <span id="connectionStatus" class="offline">
            ● Connecting...
        </span>
    </div>

    <div id="ordersContainer">

        <div id="noOrders" class="no-orders">
            <div>📦</div>
            <p>No new orders yet.</p>
            <small>
                New student orders will appear here automatically.
            </small>
        </div>

    </div>

</div>

        </div>

    </div>

</body>
<script src="/socket.io/socket.io.js"></script>

<script>
    const socket = io();

    const connectionStatus = document.getElementById("connectionStatus");

    socket.on("connect", () => {

        connectionStatus.textContent = "● Live";
        connectionStatus.classList.remove("offline");
        connectionStatus.classList.add("online");

        // Tell server this is the canteen owner
        socket.emit("canteenOwnerJoin");

        console.log("Canteen owner connected to live orders");
    });

    socket.on("disconnect", () => {

        connectionStatus.textContent = "● Offline";
        connectionStatus.classList.remove("online");
        connectionStatus.classList.add("offline");

    });
    socket.on("newOrder", (order) => {

    console.log("🔔 New order received:", order);

    const ordersContainer = document.getElementById("ordersContainer");

    // Remove "No new orders" message
    const noOrders = document.getElementById("noOrders");

    if (noOrders) {
        noOrders.remove();
    }

    const orderCard = document.createElement("div");

    orderCard.style.cssText = `
        border: 1px solid #ddd;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 15px;
        background: #f9fffc;
    `;

    orderCard.innerHTML = `
        <h3 style="color:#0B5D3B; margin-top:0;">
            🔔 New Order
        </h3>

        <p>
            <strong>Customer:</strong>
            ${order.orderedByName}
        </p>

        <p>
            <strong>Order Type:</strong>
            ${order.orderType}
        </p>

        <p>
            <strong>Items:</strong>
        </p>

        <ul>
            ${order.items.map(item => `
                <li>
                    ${item.name} × ${item.qty}
                    — ₹${item.price * item.qty}
                </li>
            `).join("")}
        </ul>

        <p>
            <strong>Total:</strong>
            ₹${order.totalAmount}
        </p>

        <p>
    <strong>Status:</strong>
    <span id="status-${order.orderId}">
        ${order.status}
    </span>
</p>

<div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:15px;">

    <button
        onclick="updateOrderStatus('${order.orderId}', 'accepted')"
        style="padding:8px 12px; border:none; border-radius:7px; cursor:pointer;">
        ✅ Accept
    </button>

    <button
        onclick="updateOrderStatus('${order.orderId}', 'preparing')"
        style="padding:8px 12px; border:none; border-radius:7px; cursor:pointer;">
        👨‍🍳 Preparing
    </button>

    <button
        onclick="updateOrderStatus('${order.orderId}', 'ready')"
        style="padding:8px 12px; border:none; border-radius:7px; cursor:pointer;">
        🍱 Ready
    </button>

    <button
        onclick="updateOrderStatus('${order.orderId}', 'completed')"
        style="padding:8px 12px; border:none; border-radius:7px; cursor:pointer;">
        ✅ Completed
    </button>

    <button
        onclick="updateOrderStatus('${order.orderId}', 'cancelled')"
        style="padding:8px 12px; border:none; border-radius:7px; cursor:pointer;">
        ❌ Cancel
    </button>

</div>
    `;

    ordersContainer.prepend(orderCard);

});

async function updateOrderStatus(orderId, status) {

    try {

        const response = await fetch(`/order/${orderId}/status`, {
            method: "PATCH",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                status: status
            })
        });

        const data = await response.json();

        if (!data.success) {
            alert(data.message || "Unable to update order.");
            return;
        }

        const statusElement = document.getElementById(`status-${orderId}`);

        if (statusElement) {
            statusElement.textContent = data.status;
        }

        console.log("Order status updated:", data.status);

    } catch (error) {

        console.error("Status update error:", error);

        alert("Something went wrong while updating the order.");
    }
}

async function loadExistingOrders() {

    try {

        const response = await fetch("/canteen-orders");

        const data = await response.json();

        if (!data.success) {
            console.error("Unable to load existing orders.");
            return;
        }

        console.log("Existing orders:", data.orders);

    } catch (error) {

        console.error("Load existing orders error:", error);

    }
}

loadExistingOrders();
</script>
</html>