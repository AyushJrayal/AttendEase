<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AttendEase • Student Dashboard</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<link rel="stylesheet" href="/css/style.css">

</head>

<body
    data-department="<%= student.department %>"
    data-semester="<%= student.semester %>"
    data-section="<%= student.section %>"
>

<div class="phone">

<%- include("partials/header") %>

<div class="card-ui">

<h3 style="text-align:center;">Welcome</h3>

<h2 style="text-align:center;margin-bottom:10px;">

<%= student.name %>

</h2>

<p style="text-align:center;color:#777;">

<%= student.department %> • Semester <%= student.semester %>

</p>



</div>

<div id="attendancePopup" class="attendance-popup">

    <i class="bi bi-bell-fill popup-icon"></i>

    <h3>Attendance Started</h3>

    <p id="countdownText">You have 60 seconds remaining.</p>

    <button id="presentBtn" class="btn btn-success w-100">

        <i class="bi bi-check-circle-fill"></i>

        Present

    </button>

</div>

<div class="card-ui">

<h4 style="margin-bottom:15px;">

Attendance Percentage

</h4>

<h1 style="text-align:center;font-size:55px;color:#0B5D3B;">

<%= percentage %>%

</h1>

<div class="progress">

<div class="progress-fill"
     data-width="<%= percentage %>">
</div>

</div>

<br>

<div style="display:flex;justify-content:space-between;text-align:center;">

<div>

<h3><%= presentAttendance %></h3>

<p>Present</p>

</div>

<div>

<h3><%= absentAttendance %></h3>

<p>Absent</p>

</div>

<div>

<h3><%= totalAttendance %></h3>

<p>Total</p>

</div>

</div>

</div>

<div class="menu">

<a href="/studentss" class="menu-card">

<i class="bi bi-people-fill"></i>

<span>Students</span>

</a>

<a href="/timetable" class="menu-card">

<i class="bi bi-calendar3"></i>

<span>Time Table</span>

</a>

<a href="/menu" class="menu-card">

<i class="bi bi-egg-fried"></i>

<span>Canteen1</span>

</a>

<a href="/logout" class="menu-card">

<i class="bi bi-box-arrow-right"></i>

<span>Logout</span>

</a>

</div>

<%- include("partials/footer") %>

<%- include("partials/bottom-nav") %>


</div>



<script>
document.querySelectorAll(".progress-fill").forEach(bar => {
    bar.style.width = bar.dataset.width + "%";
});
</script>

<script src="/socket.io/socket.io.js"></script>

<script>

const socket = io();

const studentData = document.body.dataset;

socket.emit("studentJoin", {
    department: studentData.department,
    semester: Number(studentData.semester),
    section: studentData.section
});

socket.on("attendanceStarted", (data) => {

    const popup = document.getElementById("attendancePopup");

    popup.style.display = "block";

    let timeLeft = 60;

    const countdown = document.getElementById("countdownText");

    countdown.innerHTML = `You have ${timeLeft} seconds remaining.`;

    const timer = setInterval(() => {

        timeLeft--;

        countdown.innerHTML = `You have ${timeLeft} seconds remaining.`;

        if (timeLeft <= 0) {

            clearInterval(timer);

            popup.style.display = "none";

        }

    },1000);

});

document.getElementById("presentBtn").addEventListener("click", async () => {

    const response = await fetch("/attendance/present", {

        method: "POST"

    });

    const result = await response.json();

    if(result.success){

        const btn = document.getElementById("presentBtn");

        btn.innerHTML = '<i class="bi bi-check-circle-fill"></i> Present Marked';

        btn.disabled = true;

        btn.classList.remove("btn-success");

        btn.classList.add("btn-secondary");

    }else{

        alert(result.message);

    }

});

</script>


</body>

</html>