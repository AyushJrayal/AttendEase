<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>AttendEase • Admin Login</title>

    <link
        rel="stylesheet"
        href="/css/login.css">

</head>

<body>

<div class="phone">

    <!-- University Logo -->
    <img
        src="/images/university-logo.jpg"
        class="logo"
        alt="University Logo">


    <!-- Title -->
    <h1>AttendEase</h1>

    <p class="subtitle">
        Smart Attendance System
    </p>


    <!-- Admin Login Form -->
    <form id="adminLoginForm">

      <input
    type="text"
    name="username"
    id="username"
    placeholder="Username"
    autocomplete="username"
    required>

        <input
    type="password"
    name="password"
    id="adminPassword"
    placeholder="Password"
    autocomplete="current-password"
    required>

    <div id="adminLoginError" class="login-error"></div>


        <button
            type="submit"
            class="admin">

            Admin Login

        </button>

    </form>


    <!-- Back -->
    <div class="or">
        OR
    </div>


    <a
        href="/"
        class="register">

        ← Back to Student Login

    </a>


    <!-- Footer -->
    <div class="footer">

Powered by

<strong>JC Studio</strong>

<br>

Developed by

<strong>Ayush Jaryal</strong>

<br>

🌐 Jaryal.shop

</div>

</div>

<script>

const adminForm = document.getElementById("adminLoginForm");
const usernameInput = document.getElementById("username");
const adminPassword = document.getElementById("adminPassword");
const adminLoginError = document.getElementById("adminLoginError");

adminForm.addEventListener("submit", async (e) => {

    e.preventDefault();

    adminLoginError.style.display = "none";

    usernameInput.classList.remove("input-error");
    adminPassword.classList.remove("input-error");

    const formData = new FormData(adminForm);

    try {

        const response = await fetch("/admin-login", {

            method: "POST",

            body: new URLSearchParams(formData)

        });

        if (response.ok) {

            window.location.href = "/dashboard";

        } else {

            const message = await response.text();

            adminLoginError.textContent =
                "⚠ " + message;

            adminLoginError.style.display = "block";

            adminPassword.classList.add("input-error");

            adminPassword.focus();

        }

    } catch (error) {

        adminLoginError.textContent =
            "⚠ Unable to connect. Please try again.";

        adminLoginError.style.display = "block";

    }

});


adminPassword.addEventListener("input", () => {

    adminLoginError.style.display = "none";

    adminPassword.classList.remove("input-error");

});


usernameInput.addEventListener("input", () => {

    adminLoginError.style.display = "none";

    usernameInput.classList.remove("input-error");

});

</script>

</body>

</html>