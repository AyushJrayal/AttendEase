<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Menu</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/menu.css">
</head>
<body>

    <div class="menu-header">
        <h2><i class="bi bi-gear-fill"></i> Manage Menu</h2>
        <a href="/add-menu-item" class="btn btn-light btn-sm add-item-btn">
            <i class="bi bi-plus-lg"></i> Add Item
        </a>
    </div>

    <div class="container py-4">

        <% if (menuItems.length === 0) { %>

            <div class="text-center text-muted py-5">
                <i class="bi bi-basket" style="font-size: 40px;"></i>
                <p class="mt-2">No menu items yet.</p>
            </div>

        <% } else { %>

            <div class="row g-3">

                <% menuItems.forEach(item => { %>

                    <div class="col-6 col-md-4 col-lg-3">

                        <div class="menu-card <%= item.available ? '' : 'sold-out' %>">

                            <div class="menu-img-wrap">
                                <% if (item.photoUrl) { %>
                                    <img src="<%= item.photoUrl %>" alt="<%= item.name %>">
                                <% } else { %>
                                    <div class="no-img">
                                        <i class="bi bi-image"></i>
                                    </div>
                                <% } %>

                                <% if (!item.available) { %>
                                    <span class="sold-out-badge">Sold Out</span>
                                <% } %>
                            </div>

                            <div class="menu-body">
                                <h4><%= item.name %></h4>
                                <p class="category"><%= item.category %></p>
                                <p class="price">₹<%= item.price %></p>

                                <button
                                    class="btn toggle-btn w-100"
                                    onclick="toggleItem('<%= item._id %>')">
                                    <%= item.available ? 'Mark Sold Out' : 'Mark Available' %>
                                </button>

                                <button
                                    class="btn delete-btn w-100 mt-1"
                                    onclick="deleteItem('<%= item._id %>')">
                                    <i class="bi bi-trash"></i> Delete
                                </button>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>

    <script>

        async function toggleItem(id) {
            const res = await fetch('/menu-item/' + id + '/toggle', { method: 'POST' });
            const data = await res.json();
            if (data.success) location.reload();
        }

        async function deleteItem(id) {

            if (!confirm("Delete this item permanently?")) return;

            const res = await fetch('/menu-item/' + id, { method: 'DELETE' });
            const data = await res.json();

            if (data.success) location.reload();
        }

    </script>

</body>
</html>