<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Youth Festival Registrations • AttendEase</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>


    <style>

        * {
            box-sizing: border-box;
        }

        body {

            margin: 0;

            background: #eef2f7;

            font-family: Arial, sans-serif;

            color: #222;

        }


        .festival-page {

            width: 100%;

            max-width: 950px;

            margin: auto;

            padding: 20px 15px 50px;

        }


        /* =========================
           BACK BUTTON
        ========================= */

        .back-btn {

            display: inline-block;

            color: #0B5D3B;

            text-decoration: none;

            font-weight: 600;

            margin-bottom: 15px;

        }


        /* =========================
           HEADER
        ========================= */

        .page-header {

            background: linear-gradient(
                135deg,
                #0B5D3B,
                #15803D
            );

            color: white;

            border-radius: 24px;

            padding: 25px;

            margin-bottom: 20px;

            box-shadow:
                0 10px 25px rgba(0,0,0,.12);

        }


        .logo {

            width: 65px;

            height: 65px;

            object-fit: contain;

            background: white;

            border-radius: 15px;

            padding: 5px;

        }


        .page-header h1 {

            font-size: 25px;

            font-weight: 700;

            margin: 0;

        }


        .page-header p {

            margin: 4px 0 0;

            opacity: .85;

        }


        /* =========================
           SELECT EVENT
        ========================= */

        .event-card {

            background: white;

            border-radius: 20px;

            padding: 20px;

            margin-bottom: 20px;

            box-shadow:
                0 5px 20px rgba(0,0,0,.06);

        }


        .event-card label {

            font-size: 13px;

            color: #666;

            font-weight: 600;

            margin-bottom: 7px;

        }


        .event-select {

            border: 1px solid #d7e2dc;

            border-radius: 12px;

            padding: 12px;

        }


        .event-select:focus {

            border-color: #0B5D3B;

            box-shadow:
                0 0 0 .2rem rgba(11,93,59,.12);

        }


        /* =========================
           STUDENT TABLE
        ========================= */

        .table-card {

            background: white;

            border-radius: 20px;

            padding: 18px;

            box-shadow:
                0 5px 20px rgba(0,0,0,.06);

            overflow-x: auto;

        }


        .table thead th {

            background: #0B5D3B;

            color: white;

            white-space: nowrap;

        }


        .table {

            vertical-align: middle;

        }


        .student-name {

            font-weight: 600;

        }


        .event-badge {

            display: inline-block;

            background: #eaf4ef;

            color: #0B5D3B;

            border: 1px solid #cfe3d7;

            padding: 5px 9px;

            border-radius: 8px;

            font-size: 12px;

            font-weight: 600;

        }


        /* =========================
           DOWNLOAD BUTTON
        ========================= */

        .download-btn {

            background: #0B5D3B;

            color: white;

            border: none;

            border-radius: 14px;

            padding: 14px 20px;

            font-weight: 600;

            width: 100%;

            margin-top: 20px;

        }


        .download-btn:hover {

            background: #084a2f;

            color: white;

        }


        .download-btn:disabled {

            opacity: .7;

        }


        /* =========================
           EMPTY MESSAGE
        ========================= */

        .empty-message {

            text-align: center;

            padding: 45px 20px;

            color: #777;

        }


        .empty-message i {

            font-size: 40px;

            color: #0B5D3B;

            display: block;

            margin-bottom: 10px;

        }


        /* =========================
           DOWNLOAD SHEET
        ========================= */

        /* =========================================================
   PROFESSIONAL YOUTH FESTIVAL DOWNLOAD SHEET
========================================================= */

.download-sheet {
    width: 900px;
    min-height: 1280px;

    background: #fffdf7;
    color: #202520;

    font-family:
        Arial,
        Helvetica,
        sans-serif;

    position: relative;
    overflow: hidden;

    border: 1px solid #d8c99b;
}


/* =========================================================
   DECORATIVE TOP BAR
========================================================= */

.sheet-top-bar {
    height: 14px;

    background:
        linear-gradient(
            90deg,
            #0B5D3B 0%,
            #0B5D3B 70%,
            #B08D28 70%,
            #D4AF37 100%
        );
}


/* =========================================================
   HEADER
========================================================= */

.sheet-header {
    padding: 42px 55px 25px;
}

.sheet-brand {
    display: flex;
    align-items: center;
    gap: 20px;
}

.sheet-logo {
    width: 82px;
    height: 82px;

    object-fit: contain;

    background: white;

    border: 2px solid #d4af37;

    border-radius: 50%;

    padding: 5px;
}

.sheet-brand-text {
    flex: 1;
}

.sheet-title {
    color: #0B5D3B;

    font-family:
        Georgia,
        "Times New Roman",
        serif;

    font-size: 45px;

    line-height: 1;

    font-weight: 700;

    letter-spacing: .5px;
}

.sheet-subtitle {
    margin-top: 8px;

    color: #777;

    font-size: 14px;

    letter-spacing: 2.5px;

    text-transform: uppercase;
}


/* =========================================================
   FESTIVAL BADGE
========================================================= */

.sheet-festival-badge {

    display: inline-flex;

    align-items: center;

    gap: 8px;

    margin-top: 28px;

    padding: 8px 16px;

    background: #0B5D3B;

    color: white;

    border-radius: 30px;

    font-size: 12px;

    font-weight: 700;

    letter-spacing: 1.5px;

    text-transform: uppercase;
}

.sheet-festival-badge span {
    color: #D4AF37;
}


/* =========================================================
   EVENT TITLE
========================================================= */

.sheet-event-wrapper {

    margin: 25px 55px 0;

    padding: 22px 25px;

    background:
        linear-gradient(
            135deg,
            #f4f8f5,
            #fffdf7
        );

    border-left: 6px solid #0B5D3B;

    border-right: 1px solid #e4dcc2;

    border-top: 1px solid #e4dcc2;

    border-bottom: 1px solid #e4dcc2;

    border-radius: 0 12px 12px 0;
}

.sheet-event-label {

    color: #8b8b8b;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 2px;

    text-transform: uppercase;

    margin-bottom: 6px;
}

.sheet-event {

    color: #0B5D3B;

    font-family: Georgia, serif;

    font-size: 30px;

    font-weight: 700;

    line-height: 1.2;
}


/* =========================================================
   GOLD LINE
========================================================= */

.sheet-line {

    height: 3px;

    background:
        linear-gradient(
            90deg,
            #0B5D3B,
            #0B5D3B 75%,
            #D4AF37 75%,
            #D4AF37
        );

    margin: 25px 55px 0;
}


/* =========================================================
   INFORMATION BOX
========================================================= */

.sheet-info {

    margin: 25px 55px 0;

    display: grid;

    grid-template-columns:
        1fr
        1fr
        1fr;

    gap: 12px;
}

.sheet-info-box {

    background: white;

    border: 1px solid #e3dfd0;

    border-radius: 10px;

    padding: 13px 15px;
}

.sheet-info-box strong {

    display: block;

    color: #888;

    font-size: 10px;

    letter-spacing: 1.5px;

    text-transform: uppercase;

    margin-bottom: 5px;
}

.sheet-info-box span {

    display: block;

    color: #222;

    font-size: 17px;

    font-weight: 700;
}


/* =========================================================
   REGISTERED COUNT
========================================================= */

.sheet-count {

    margin: 25px 55px 20px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 14px 18px;

    background: #0B5D3B;

    color: white;

    border-radius: 10px;
}

.sheet-count-label {

    font-size: 12px;

    letter-spacing: 1.2px;

    text-transform: uppercase;

    opacity: .9;
}

.sheet-count-number {

    font-size: 22px;

    font-weight: 800;

    color: #D4AF37;
}


/* =========================================================
   TABLE
========================================================= */

.sheet-table-head {

    display: grid;

    grid-template-columns:
        70px
        minmax(0, 1fr)
        170px
        170px;

    align-items: center;

    min-height: 48px;

    background: #0B5D3B;

    color: white;

    padding: 0 55px;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 1.2px;

    text-transform: uppercase;
}

.sheet-table-head span:last-child {
    text-align: right;
}


/* =========================================================
   STUDENT ROW
========================================================= */

.sheet-row {

    display: grid;

    grid-template-columns:
        70px
        minmax(0, 1fr)
        170px
        170px;

    align-items: center;

    min-height: 50px;

    padding: 0 55px;

    border-bottom:
        1px solid #e6e3d8;

    font-size: 15px;

    background: rgba(255,255,255,.9);
}

.sheet-row:nth-child(even) {
    background: #f7f8f4;
}

.sheet-row span:first-child {

    color: #777;

    font-weight: 600;
}

.sheet-row span:nth-child(2) {

    color: #222;

    font-weight: 700;

    padding-right: 15px;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;
}

.sheet-row span:nth-child(3) {

    color: #444;

    font-weight: 600;
}

.sheet-row span:last-child {

    color: #0B5D3B;

    font-size: 13px;

    font-weight: 600;

    text-align: right;
}


/* =========================================================
   WATERMARK
========================================================= */

.download-sheet::after {

    content: "";

    position: absolute;

    width: 400px;

    height: 400px;

    left: 50%;

    top: 480px;

    transform: translateX(-50%);

    background-image:
        url("/images/university-logo.jpg");

    background-repeat: no-repeat;

    background-position: center;

    background-size: contain;

    opacity: .035;

    pointer-events: none;
}


/* =========================================================
   FOOTER
========================================================= */

.sheet-footer {

    position: absolute;

    left: 55px;

    right: 55px;

    bottom: 35px;

    padding-top: 18px;

    border-top:
        1px solid #d9d5c7;

    text-align: center;

    color: #888;

    font-size: 11px;

    line-height: 20px;
}

.sheet-footer strong {

    color: #0B5D3B;

    font-weight: 700;
}

.sheet-footer .gold {

    color: #B08D28;
}

.sheet-page {

    margin-top: 5px;

    color: #aaa;

    font-size: 10px;
}


/* =========================================================
   OFF-SCREEN RENDER
========================================================= */

.sheet-render-slot {

    position: fixed;

    left: -20000px;

    top: 0;

    z-index: -1;
}


        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 600px) {

            .festival-page {

                padding: 12px 10px 40px;

            }


            .page-header {

                padding: 20px;

                border-radius: 20px;

            }


            .page-header h1 {

                font-size: 21px;

            }


            .logo {

                width: 55px;

                height: 55px;

            }


            .table-card {

                padding: 10px;

            }


            .table {

                font-size: 13px;

            }

        }

    </style>

</head>


<body>


<div class="festival-page">


    <!-- BACK -->

    <a href="/dashboard" class="back-btn">

        <i class="bi bi-arrow-left"></i>

        Teacher Dashboard

    </a>


    <!-- HEADER -->

    <div class="page-header">

        <div class="d-flex align-items-center gap-3">

            <img
                src="/images/university-logo.jpg"
                class="logo"
                alt="University Logo">

            <div>

                <h1>
                    Youth Festival Registrations
                </h1>

                <p>
                    Manage registered students and events
                </p>

            </div>

        </div>

    </div>


    <!-- EVENT SELECTOR -->

    <div class="event-card">

        <label for="eventSelect">

            Select Youth Festival Event

        </label>


        <select
            id="eventSelect"
            class="form-select event-select">

            <option value="">

                Select an event

            </option>

            <% [...new Set(festStudents.map(student => student.event))]
                .filter(Boolean)
                .sort()
                .forEach(event => { %>

                <option value="<%= event %>">

                    <%= event %>

                </option>

            <% }) %>

        </select>

    </div>


    <!-- STUDENT LIST -->

    <div class="table-card">


        <h5 class="mb-3">

            <i class="bi bi-people-fill"></i>

            Registered Students

        </h5>


        <div id="emptyMessage" class="empty-message">

            <i class="bi bi-calendar-event"></i>

            <div>

                Select an event to view registered students.

            </div>

        </div>


        <div
            id="studentTableContainer"
            style="display:none;">

            <div class="table-responsive">

                <table class="table table-bordered">

                    <thead>

                        <tr>

                            <th>#</th>

                            <th>Student</th>

                            <th>Roll No</th>

                            <th>Department</th>

                            <th>Semester</th>

                            <th>Section</th>

                            <th>Mobile</th>

                        </tr>

                    </thead>


                    <tbody id="studentTableBody">

                    </tbody>

                </table>

            </div>


            <button
                class="download-btn"
                id="downloadBtn"
                onclick="downloadFestivalList()">

                <i class="bi bi-download"></i>

                Download Selected Event

            </button>

        </div>

    </div>


</div>


<!-- =====================================================
     FESTIVAL DATA
===================================================== -->

<script type="application/json" id="festData">

<%- JSON.stringify(festStudents.map(student => ({

    name: student.name,

    rollNo: student.rollNo,

    department: student.department,

    semester: student.semester,

    section: student.section,

    mobile: student.mobile,

    event: student.event

}))) %>

</script>


<!-- =====================================================
     DOWNLOAD TEMPLATE
===================================================== -->

<template id="festivalSheetTemplate">

    <div class="download-sheet">

        <!-- TOP DECORATIVE BAR -->

        <div class="sheet-top-bar"></div>


        <!-- HEADER -->

        <div class="sheet-header">

            <div class="sheet-brand">

                <img
                    src="/images/university-logo.jpg"
                    class="sheet-logo"
                    alt="University Logo">

                <div class="sheet-brand-text">

                    <div class="sheet-title">
                        AttendEase
                    </div>

                    <div class="sheet-subtitle">
                        Smart Attendance & Student Management
                    </div>

                </div>

            </div>


            <div class="sheet-festival-badge">

                <span>✦</span>

                Youth Festival 2026

                <span>✦</span>

            </div>

        </div>


        <!-- EVENT -->

        <div class="sheet-event-wrapper">

            <div class="sheet-event-label">
                Registered Event
            </div>

            <div class="sheet-event sheet-selected-event">
            </div>

        </div>


        <!-- LINE -->

        <div class="sheet-line"></div>


        <!-- INFORMATION -->

        <div class="sheet-info">

            <div class="sheet-info-box">

                <strong>
                    Category
                </strong>

                <span>
                    Youth Festival
                </span>

            </div>


            <div class="sheet-info-box">

                <strong>
                    Document
                </strong>

                <span>
                    Registration List
                </span>

            </div>


            <div class="sheet-info-box">

                <strong>
                    Generated
                </strong>

                <span class="sheet-date">
                </span>

            </div>

        </div>


        <!-- COUNT -->

        <div class="sheet-count">

            <span class="sheet-count-label">
                Total Registered Students
            </span>

            <span class="sheet-count-number">
                <span class="student-count"></span>
            </span>

        </div>


        <!-- TABLE HEADER -->

        <div class="sheet-table-head">

            <span>
                #
            </span>

            <span>
                Student Name
            </span>

            <span>
                Roll Number
            </span>

            <span>
                Department
            </span>

        </div>


        <!-- STUDENTS -->

        <div class="sheet-rows">
        </div>


        <!-- FOOTER -->

        <div class="sheet-footer">

            <div>
                Official Youth Festival Registration Record
            </div>

            <div>
                Generated by
                <strong>AttendEase</strong>
            </div>

            <div>
                Designed & Developed by
                <strong class="gold">
                    Ayush Jaryal
                </strong>
            </div>

            <div>
                Smart Attendance & Student Management System
            </div>

            <div class="sheet-page">
                <span class="page-number"></span>
            </div>

        </div>

    </div>

</template>


<script>

const festivalData = JSON.parse(
    document.getElementById("festData").textContent
);


const eventSelect = document.getElementById(
    "eventSelect"
);


const tableContainer = document.getElementById(
    "studentTableContainer"
);


const tableBody = document.getElementById(
    "studentTableBody"
);


const emptyMessage = document.getElementById(
    "emptyMessage"
);


let selectedStudents = [];


/* =========================================
   EVENT CHANGE
========================================= */

eventSelect.addEventListener("change", function () {

    const selectedEvent = this.value;


    if (!selectedEvent) {

        tableContainer.style.display = "none";

        emptyMessage.style.display = "block";

        selectedStudents = [];

        return;

    }


    selectedStudents = festivalData.filter(
        student => student.event === selectedEvent
    );


    if (selectedStudents.length === 0) {

        tableContainer.style.display = "none";

        emptyMessage.innerHTML = `
            <i class="bi bi-person-x"></i>
            No students registered for this event.
        `;

        emptyMessage.style.display = "block";

        return;

    }


    emptyMessage.style.display = "none";

    tableContainer.style.display = "block";


    tableBody.innerHTML = selectedStudents
        .map((student, index) => `

            <tr>

                <td>
                    ${index + 1}
                </td>

                <td>
                    <span class="student-name">
                        ${student.name}
                    </span>
                </td>

                <td>
                    ${student.rollNo}
                </td>

                <td>
                    ${student.department}
                </td>

                <td>
                    Semester ${student.semester}
                </td>

                <td>
                    Section ${student.section}
                </td>

                <td>
                    ${student.mobile}
                </td>

            </tr>

        `)
        .join("");

});


/* =========================================
   DOWNLOAD SELECTED EVENT
========================================= */

async function downloadFestivalList() {

    if (!selectedStudents.length) {

        alert("Please select an event first.");

        return;

    }


    const button = document.getElementById(
        "downloadBtn"
    );


    const template = document.getElementById(
        "festivalSheetTemplate"
    );


    button.disabled = true;

    button.innerHTML = `
        <i class="bi bi-hourglass-split"></i>
        Creating download...
    `;


    try {

        const sheet =
            template.content
            .firstElementChild
            .cloneNode(true);


        const selectedEvent =
            eventSelect.value;


        sheet.querySelector(
            ".sheet-selected-event"
        ).textContent = selectedEvent;


        const rows =
            sheet.querySelector(".sheet-rows");


        rows.innerHTML = selectedStudents
            .map((student, index) => `

                <div class="sheet-row">

                    <span>
                        ${index + 1}
                    </span>

                    <span>
                        ${student.name}
                    </span>

                    <span>
                        ${student.rollNo}
                    </span>

                    <span>
                        ${student.department}
                    </span>

                </div>

            `)
            .join("");


        const slot =
            document.createElement("div");


        slot.className =
            "sheet-render-slot";


        slot.appendChild(sheet);


        document.body.appendChild(slot);


        await new Promise(resolve =>
            requestAnimationFrame(() =>
                requestAnimationFrame(resolve)
            )
        );


        const canvas =
            await html2canvas(sheet, {

                scale: 3,

                useCORS: true,

                backgroundColor: "#ffffff",

                logging: false

            });


        const link =
            document.createElement("a");


        link.download =
            `AttendEase-Festival-${selectedEvent}.png`;


        link.href =
            canvas.toDataURL("image/png");


        link.click();


        document.body.removeChild(slot);


        button.innerHTML = `
            <i class="bi bi-check-circle-fill"></i>
            Downloaded
        `;


        setTimeout(() => {

            button.disabled = false;

            button.innerHTML = `
                <i class="bi bi-download"></i>
                Download Selected Event
            `;

        }, 2000);


    } catch (error) {

        console.error(error);

        alert(
            "Unable to create festival list."
        );


        button.disabled = false;

        button.innerHTML = `
            <i class="bi bi-download"></i>
            Download Selected Event
        `;

    }

}

</script>


</body>

</html>